# Token dell'API WindDoc, usati a build time per generare /blog e /blog/eventi/[id].
# Copia questo file in `.env` e inserisci i valori reali.
# In CI vanno impostati come secret dell'ambiente di build, non committati.
WINDDOC_TOKEN_APP=
WINDDOC_TOKEN_KEY=

# Dominio pubblico definitivo. Se non impostata, in produzione su Vercel viene
# usato automaticamente VERCEL_PROJECT_PRODUCTION_URL; in locale un segnaposto.
SITE_URL=

# Indicizzazione sui motori di ricerca. Lasciare vuota (o diversa da "true")
# finché il sito contiene segnaposto o il modulo contatti non recapita:
# robots.txt vieta la scansione e ogni pagina esce con meta noindex.
SITE_INDEXABLE=

# Chiave del modulo contatti. Si ottiene su https://web3forms.com indicando
# la casella di destinazione (corpobandistico.castelcovati@gmail.com): la
# chiave arriva via email, non serve creare un account.
# Senza questa variabile il modulo si disattiva e mostra l'indirizzo diretto,
# invece di accettare messaggi e perderli.
WEB3FORMS_KEY=
