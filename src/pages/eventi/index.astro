---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

// Pagina generata a ogni richiesta: gli eventi arrivano da WindDoc al momento
// della visita, non alla build. Un evento nuovo compare senza rideploy.
export const prerender = false;
import HeroSection from '../../components/sections/heros/HeroSection.astro';
import EventoCard from '../../components/eventi/EventoCard.astro';

import {
  WINDDOC_URL,
  TOKEN_APP,
  TOKEN_KEY,
  toFormUrlEncoded,
} from '../../lib/winddoc';

function stripHtml(html: string): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
}

async function fetchEventi({ pagina = 1 } = {}) {
  const bodyObj = {
    method: 'associazioni_eventi_lista',
    request: {
      token_key: {
        token: TOKEN_KEY,
        token_app: TOKEN_APP,
      },
      // query: 'data_evento > NOW()', // ❌ togli il filtro qui
      pagina,
    },
  };

  const res = await fetch(WINDDOC_URL, {
    method: 'POST',
    headers: {
      Accept: 'application/json',
      'Content-Type': 'application/x-www-form-urlencoded',
    },
    body: toFormUrlEncoded(bodyObj),
  });

  if (!res.ok) {
    throw new Error(`Errore richiesta WindDoc lista: ${res.status}`);
  }

  const data = await res.json();
  return data;
}

let eventiLista: any[] = [];
// Distingue "nessun evento in programma" da "WindDoc non risponde": sono due
// messaggi diversi per il visitatore, e nel secondo caso non va messo in cache.
let winddocRaggiungibile = true;

try {
  const data = await fetchEventi({ pagina: 1 });
  if (data && data.success && Array.isArray(data.lista)) {
    eventiLista = data.lista;
  } else {
    winddocRaggiungibile = false;
    console.warn('[WindDoc lista] struttura inattesa:', data);
  }
} catch (err) {
  winddocRaggiungibile = false;
  console.error('[WindDoc lista] errore chiamando API:', err);
}

// La pagina e' generata a ogni richiesta: la cache CDN tiene 30s cosi' un evento
// appena pubblicato compare quasi subito senza ridistribuire il sito.
Astro.response.headers.set(
  'Cache-Control',
  winddocRaggiungibile
    ? 'public, s-maxage=30, stale-while-revalidate=300'
    : 'no-store'
);

const eventiRaw = eventiLista.map((evento) => {
  const id = evento.id_associazione_evento;
  const titolo = evento.nome ?? 'Evento senza titolo';
  const descrizioneHtml = evento.descrizione ?? '';
  const descrizioneTesto = stripHtml(descrizioneHtml);
  const luogo = evento.indirizzo ?? '';
  // Radio "Iscrizione" della scheda evento WindDoc, decodificato dal componente.
  const tipoIscrizione = evento.tipo_iscrizione_socio;
  const rawDate = evento.data_evento;
  const dateObj = rawDate ? new Date(rawDate) : null;

  const image =
      evento.logo &&
      typeof evento.logo === 'object' &&
      'link' in evento.logo
        ? (evento.logo as any).link
        : null;

  return {
    id,
    title: titolo,
    descriptionHtml: descrizioneHtml,
    descriptionText: descrizioneTesto,
    place: luogo,
    tipoIscrizione,
    date: dateObj,
    image,
    href: id ? `/eventi/${id}` : null,
  };
});

// Filtra solo quelli con una data valida
const now = new Date();

const eventiFuturi = eventiRaw
  .filter((e) => e.date && e.date >= now)
  .sort((a, b) => (a.date! > b.date! ? 1 : -1)); // dal più vicino al più lontano

const eventiPassati = eventiRaw
  .filter((e) => e.date && e.date < now)
  .sort((a, b) => (a.date! > b.date! ? -1 : 1)); // dal più recente al più vecchio

const seo = {
  title: 'Eventi | Corpo Bandistico di Castelcovati',
  description:
    'I prossimi concerti e servizi del Corpo Bandistico di Castelcovati, e l’archivio di quelli passati.',
};
---

<Layout {seo}>
  <HeroSection>
    <div slot="text-container">
      <h1>Eventi</h1>
      <p>
        Scopri i prossimi appuntamenti del Corpo Bandistico di Castelcovati
        e ripercorri gli eventi passati.
      </p>
    </div>

    <div slot="image-container">
      <img
        src="/assets/images/hero-event-list.jpeg"
        alt="Concerto del Corpo Bandistico di Castelcovati"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1200"
        height="800"
      />
    </div>
  </HeroSection>

  <Container>
    <section class="eventi-lista">
      {!winddocRaggiungibile && (
        <p class="eventi-avviso">
          Non riusciamo a leggere il calendario in questo momento. Riprova fra
          poco: gli eventi sono anche sui nostri canali social.
        </p>
      )}
      {winddocRaggiungibile && eventiRaw.length === 0 && (
        <p class="eventi-avviso">
          Al momento non ci sono eventi in programma. Torna a trovarci, oppure
          seguici sui social per non perdere i prossimi appuntamenti.
        </p>
      )}
      {eventiFuturi.length > 0 && (
        <>
          <h2>Prossimi eventi</h2>

          {eventiFuturi.map((evento) => (
            <EventoCard {evento} />
          ))}
        </>
      )}

      {eventiPassati.length > 0 && (
        <>
          <h2>Eventi passati</h2>

          {eventiPassati.map((evento) => (
            <EventoCard {evento} />
          ))}
        </>
      )}
    </section>
  </Container>
</Layout>

<style>
.eventi-avviso {
  padding: var(--nota-padding);
  border-left: 3px solid var(--theme-accent);
  background: var(--theme-surface-1);
  border-radius: var(--nota-radius);
  max-width: none;
}
</style>
