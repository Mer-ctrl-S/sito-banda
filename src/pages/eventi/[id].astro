---
import Layout from '../../layouts/Page.astro';
import { Container, Button } from '@components/odyssey-theme';
import { format } from 'date-fns';
import it from 'date-fns/locale/it/index.js';
import {
  WINDDOC_URL,
  TOKEN_APP,
  TOKEN_KEY,
  toFormUrlEncoded,
} from '../../lib/winddoc';

// 1) getStaticPaths: genera le route /blog/eventi/[id_associazione_evento]
export async function getStaticPaths() {
  const bodyLista = {
    method: 'associazioni_eventi_lista',
    request: {
      token_key: {
        token: TOKEN_KEY,
        token_app: TOKEN_APP,
      },
      pagina: 1,
    },
  };

  const res = await fetch(WINDDOC_URL, {
    method: 'POST',
    headers: {
      Accept: 'application/json',
      'Content-Type': 'application/x-www-form-urlencoded',
    },
    body: toFormUrlEncoded(bodyLista),
  });

  if (!res.ok) {
    throw new Error(
      `Errore richiesta WindDoc lista (getStaticPaths): ${res.status}`
    );
  }

  const data = await res.json();
  const lista =
    data && data.success && Array.isArray(data.lista) ? data.lista : [];

  const paths = lista
    .map((evento: any) => {
      const id = evento.id_associazione_evento?.toString();
      if (!id) return null;
      return { params: { id } };
    })
    .filter(Boolean);

  console.log('[getStaticPaths] paths generati:', paths);
  return paths;
}

// 2) frontmatter: usa Astro.params.id per chiamare il DETTAGLIO
const { id } = Astro.params;

async function fetchEventoDettaglio(id: string) {
  const bodyObj = {
    method: 'associazioni_eventi_dettaglio',
    request: {
      token_key: {
        token: TOKEN_KEY,
        token_app: TOKEN_APP,
      },
      id,
    },
  };

  const res = await fetch(WINDDOC_URL, {
    method: 'POST',
    headers: {
      Accept: 'application/json',
      'Content-Type': 'application/x-www-form-urlencoded',
    },
    body: toFormUrlEncoded(bodyObj),
  });

  if (!res.ok) {
    throw new Error(`Errore richiesta WindDoc dettaglio: ${res.status}`);
  }

  const data = await res.json();
  return data;
}

let eventoDettaglio: any = null;

try {
  const data = await fetchEventoDettaglio(id);
  console.log('[WindDoc dettaglio] raw payload:', data);

  eventoDettaglio = data;

  console.log(
    '[WindDoc dettaglio] evento:',
    'id:',
    eventoDettaglio?.id_associazione_evento,
    'nome:',
    eventoDettaglio?.nome,
  );
  console.log('[WindDoc dettaglio] logo:', eventoDettaglio?.logo);
  console.log(
    '[WindDoc dettaglio] logo.link:',
    eventoDettaglio?.logo && typeof eventoDettaglio.logo === 'object'
      ? (eventoDettaglio.logo as any).link
      : null
  );
} catch (err) {
  console.error('[WindDoc dettaglio] errore:', err);
}

if (!eventoDettaglio) {
  eventoDettaglio = {
    id_associazione_evento: id,
    nome: 'Evento non trovato',
    descrizione: '',
    indirizzo: '',
    data_evento: null,
  };
}

const titolo =
  eventoDettaglio.nome ?? eventoDettaglio.titolo ?? 'Evento senza titolo';
const descrizione = eventoDettaglio.descrizione ?? '';
const luogo = eventoDettaglio.indirizzo ?? '';
const rawDate = eventoDettaglio.data_evento;
const dateObj = rawDate ? new Date(rawDate) : null;

// 🖼 immagine dal logo, se presente
const image =
  eventoDettaglio.logo &&
  typeof eventoDettaglio.logo === 'object' &&
  'link' in eventoDettaglio.logo
    ? (eventoDettaglio.logo as any).link
    : null;

console.log('[WindDoc dettaglio] image:', image, 'typeof image:', typeof image);

// 🔎 informazioni su iscrizione e quota
const iscrizioneEvento = eventoDettaglio.iscrizione_evento;  // es. "0", "1", "2"
const quotaRaw = eventoDettaglio.quota;                      // stringa "0.0000", "15.0000", ecc.
const tipoQuota = eventoDettaglio.tipo_quota;                // es. "0" o "1" (non usato ma tenuto per futuro)

const quotaNumber = quotaRaw ? Number.parseFloat(quotaRaw) : 0;

let tipoPartecipazione = 'Partecipazione libera';
let dettaglioQuota = 'Evento gratuito';

if (quotaNumber > 0) {
  dettaglioQuota = `Quota di partecipazione: ${quotaNumber.toFixed(2)} €`;
} else {
  dettaglioQuota = 'Evento gratuito';
}

// Adatta questi testi ai significati reali di iscrizione_evento in WindDoc
switch (iscrizioneEvento) {
  case '0':
    tipoPartecipazione = 'Riservato ai soci tesserati (senza iscrizione obbligatoria)';
    break;
  case '1':
    tipoPartecipazione = 'Partecipazione libera (senza iscrizione obbligatoria)';
    break;
  case '2':
    tipoPartecipazione = 'Partecipazione libera (Iscrizione obbligatoria)';
    break;
  case '3':
    tipoPartecipazione = 'Riservato ai soci tesserati (iscrizione obbligatoria)';
    break;
  default:
    tipoPartecipazione = 'Partecipazione libera';
    break;
}

const seo = {
  title: `${titolo} | Evento`,
  description:
    descrizione
      ? descrizione.slice(0, 150) + (descrizione.length > 150 ? '…' : '')
      : `Dettaglio evento ${titolo}`,
};
---

<Layout {seo}>
  <Container>
    <section class="evento-dettaglio">
      <header class="evento-dettaglio__header">
        <Button href="/eventi" outlined>
          ← Torna agli eventi
        </Button>

        <h1>{titolo}</h1>

        {dateObj && (
          <p class="evento-dettaglio__meta">
            {format(
              dateObj,
              "EEEE d MMMM yyyy",
              { locale: it }
            )}
            {luogo && ` · ${luogo}`}
          </p>
        )}

        {!dateObj && (luogo || id) && (
          <p class="evento-dettaglio__meta">
            {luogo && luogo}
            {id && !luogo && `ID evento: ${id}`}
          </p>
        )}
      </header>

      {image && (
        <div class="evento-dettaglio__image">
          <img src={image} alt={titolo} loading="lazy" decoding="async" />
        </div>
      )}

      {descrizione && (
        <div class="evento-dettaglio__content">
          <h2>Descrizione</h2>
          <div
            class="evento-dettaglio__description"
            set:html={descrizione}
          />
        </div>
      )}

      <div class="evento-dettaglio__content evento-dettaglio__tipo">
        <h2>Tipo di evento</h2>

        <p class="evento-dettaglio__tipo-partecipazione">
          {tipoPartecipazione}
        </p>

        <p class="evento-dettaglio__tipo-quota">
          {dettaglioQuota}
        </p>
      </div>
    </section>
  </Container>
</Layout>

<style>
  .evento-dettaglio {
    margin: var(--section-margin) auto;
    max-width: 768px;
  }

  .evento-dettaglio__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .evento-dettaglio__meta {
    font-size: 0.95rem;
    color: var(--theme-on-surface-2);
  }

  .evento-dettaglio__image {
    margin: var(--space-md) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--theme-elevation-1);
  }

  .evento-dettaglio__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .evento-dettaglio__content {
    margin-top: var(--space-sm);
  }

  .evento-dettaglio__content h2 {
    margin-bottom: var(--space-2xs);
  }

  .evento-dettaglio__content p {
    line-height: 1.6;
  }

  .evento-dettaglio__tipo {
    margin-top: var(--space-lg);
    padding: var(--blocco-padding);
    border-radius: var(--radius-lg);
    background: var(--theme-surface-1);
  }

  .evento-dettaglio__tipo-partecipazione,
  .evento-dettaglio__tipo-quota {
    margin: 0.25rem 0;
    line-height: 1.5;
    font-size: 0.98rem;
  }
</style>
