---
import Layout from '../../layouts/Page.astro';
import { Container, Button } from '@components/odyssey-theme';
import { format } from 'date-fns';
import TipoPartecipazione from '../../components/eventi/TipoPartecipazione.astro';
import it from 'date-fns/locale/it/index.js';
import {
  WINDDOC_URL,
  TOKEN_APP,
  TOKEN_KEY,
  toFormUrlEncoded,
  statoIscrizione,
} from '../../lib/winddoc';

// Pagina generata a ogni richiesta: niente getStaticPaths, l'id arriva
// dall'URL. Così un evento appena pubblicato è raggiungibile subito, senza
// che il sito venga ricostruito.
export const prerender = false;

// L'id viene dall'URL e serve a chiedere il DETTAGLIO a WindDoc
const { id } = Astro.params;

async function fetchEventoDettaglio(id: string) {
  const bodyObj = {
    method: 'associazioni_eventi_dettaglio',
    request: {
      token_key: {
        token: TOKEN_KEY,
        token_app: TOKEN_APP,
      },
      id,
    },
  };

  const res = await fetch(WINDDOC_URL, {
    method: 'POST',
    headers: {
      Accept: 'application/json',
      'Content-Type': 'application/x-www-form-urlencoded',
    },
    body: toFormUrlEncoded(bodyObj),
  });

  if (!res.ok) {
    throw new Error(`Errore richiesta WindDoc dettaglio: ${res.status}`);
  }

  const data = await res.json();
  return data;
}

let eventoDettaglio: any = null;

try {
  const data = await fetchEventoDettaglio(id);
  console.log('[WindDoc dettaglio] raw payload:', data);

  eventoDettaglio = data;

  console.log(
    '[WindDoc dettaglio] evento:',
    'id:',
    eventoDettaglio?.id_associazione_evento,
    'nome:',
    eventoDettaglio?.nome,
  );
  console.log('[WindDoc dettaglio] logo:', eventoDettaglio?.logo);
  console.log(
    '[WindDoc dettaglio] logo.link:',
    eventoDettaglio?.logo && typeof eventoDettaglio.logo === 'object'
      ? (eventoDettaglio.logo as any).link
      : null
  );
} catch (err) {
  console.error('[WindDoc dettaglio] errore:', err);
}

/*
  Su una rotta generata a richiesta lo stato HTTP conta: un id inesistente
  deve rispondere 404, non 200 con scritto "non trovato".
*/
const trovato = Boolean(eventoDettaglio && eventoDettaglio.nome);
if (!trovato) {
  Astro.response.status = 404;
}
Astro.response.headers.set(
  'Cache-Control',
  trovato ? 'public, s-maxage=30, stale-while-revalidate=300' : 'no-store'
);

if (!eventoDettaglio) {
  eventoDettaglio = {
    id_associazione_evento: id,
    nome: 'Evento non trovato',
    descrizione: '',
    indirizzo: '',
    data_evento: null,
  };
}

const titolo =
  eventoDettaglio.nome ?? eventoDettaglio.titolo ?? 'Evento senza titolo';
const descrizione = eventoDettaglio.descrizione ?? '';
const luogo = eventoDettaglio.indirizzo ?? '';
const rawDate = eventoDettaglio.data_evento;
const dateObj = rawDate ? new Date(rawDate) : null;

// 🖼 immagine dal logo, se presente
const image =
  eventoDettaglio.logo &&
  typeof eventoDettaglio.logo === 'object' &&
  'link' in eventoDettaglio.logo
    ? (eventoDettaglio.logo as any).link
    : null;

console.log('[WindDoc dettaglio] image:', image, 'typeof image:', typeof image);

// Quota e tipo di partecipazione.
//
// Il tipo di partecipazione arriva da `tipo_iscrizione_socio` (il gruppo di
// radio nella scheda evento) e viene decodificato dal componente. In
// precedenza qui si leggeva `iscrizione_evento`, che e' un'altra cosa: dice
// da quando a quando le iscrizioni sono aperte, non chi puo' partecipare.
const tipoIscrizioneSocio = eventoDettaglio.tipo_iscrizione_socio;

// Modulo d'iscrizione: solo su eventi futuri che lo richiedono davvero.
const iscrizione = statoIscrizione(eventoDettaglio, dateObj, new Date());

const quotaRaw = eventoDettaglio.quota; // stringa tipo "0.0000" o "15.0000"
const quotaNumber = quotaRaw ? Number.parseFloat(quotaRaw) : 0;
const dettaglioQuota =
  quotaNumber > 0
    ? `Quota di partecipazione: ${quotaNumber.toFixed(2)} €`
    : 'Evento gratuito';

const seo = {
  title: `${titolo} | Evento`,
  description:
    descrizione
      ? descrizione.slice(0, 150) + (descrizione.length > 150 ? '…' : '')
      : `Dettaglio evento ${titolo}`,
};
---

<Layout {seo}>
  <Container>
    <section class="evento-dettaglio">
      <header class="evento-dettaglio__header">
        <Button href="/eventi" outlined>
          ← Torna agli eventi
        </Button>

        <h1>{titolo}</h1>

        {dateObj && (
          <p class="evento-dettaglio__meta">
            {format(
              dateObj,
              "EEEE d MMMM yyyy",
              { locale: it }
            )}
            {luogo && ` · ${luogo}`}
          </p>
        )}

        {!dateObj && (luogo || id) && (
          <p class="evento-dettaglio__meta">
            {luogo && luogo}
            {id && !luogo && `ID evento: ${id}`}
          </p>
        )}
      </header>

      {image && (
        <div class="evento-dettaglio__image">
          <img src={image} alt={titolo} loading="lazy" decoding="async" />
        </div>
      )}

      {descrizione && (
        <div class="evento-dettaglio__content">
          <h2>Descrizione</h2>
          <div
            class="evento-dettaglio__description"
            set:html={descrizione}
          />
        </div>
      )}

      <div class="evento-dettaglio__content evento-dettaglio__tipo">
        <h2>Tipo di evento</h2>

        <TipoPartecipazione valore={tipoIscrizioneSocio} dimensione="md" />

        <p class="evento-dettaglio__tipo-quota">
          {dettaglioQuota}
        </p>

        {iscrizione.stato === 'aperta' && (
          <div class="evento-dettaglio__iscrizione">
            <Button href={iscrizione.link} newTab>Iscriviti all’evento</Button>
            <p class="evento-dettaglio__iscrizione-nota">
              {iscrizione.scadenza
                ? `Il modulo si apre su WindDoc. Iscrizioni entro ${format(
                    iscrizione.scadenza,
                    "d MMMM yyyy, HH:mm",
                    { locale: it }
                  )}.`
                : 'Il modulo si apre su WindDoc.'}
            </p>
          </div>
        )}

        {iscrizione.stato === 'chiusa' && (
          <p class="evento-dettaglio__iscrizione-nota">
            Le iscrizioni si sono chiuse il {format(
              iscrizione.scadenza,
              "d MMMM yyyy",
              { locale: it }
            )}.
          </p>
        )}
      </div>
    </section>
  </Container>
</Layout>

<style>
  .evento-dettaglio {
    margin: var(--section-margin) auto;
    max-width: 768px;
  }

  .evento-dettaglio__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .evento-dettaglio__meta {
    font-size: 0.95rem;
    color: var(--theme-on-surface-2);
  }

  .evento-dettaglio__image {
    margin: var(--space-md) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--theme-elevation-1);
  }

  .evento-dettaglio__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .evento-dettaglio__content {
    margin-top: var(--space-sm);
  }

  .evento-dettaglio__content h2 {
    margin-bottom: var(--space-2xs);
  }

  .evento-dettaglio__content p {
    line-height: 1.6;
  }

  .evento-dettaglio__tipo {
    margin-top: var(--space-lg);
    padding: var(--blocco-padding);
    border-radius: var(--radius-lg);
    background: var(--theme-surface-1);
  }

  .evento-dettaglio__tipo h2 {
    margin: 0 0 var(--space-2xs);
  }

  .evento-dettaglio__iscrizione {
    margin-top: var(--space-sm);
  }

  .evento-dettaglio__iscrizione-nota {
    margin: var(--space-2xs) 0 0;
    font-size: 0.9rem;
    color: var(--theme-on-surface-2);
  }

  .evento-dettaglio__tipo-quota {
    margin: var(--space-2xs) 0 0;
    line-height: 1.5;
    font-size: 0.98rem;
  }
</style>
