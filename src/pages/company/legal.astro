---
import { TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import settings from '../../config/settings.js';

/*
  DA COMPLETARE A CURA DELL'ASSOCIAZIONE.
  Questa pagina conteneva ancora il testo segnaposto in Lorem Ipsum del tema
  originale. E' stata sostituita con una traccia in italiano: i contenuti
  legali (privacy, cookie, dati dell'ente) vanno scritti da chi ha i dati
  reali e, per l'informativa privacy, preferibilmente con un consulente.
  Il collegamento nel footer punta qui.
*/

const cf = settings.codiceFiscale?.trim() ?? '';
const etichettaCf = settings.codiceFiscaleAnchePartitaIva
	? 'Codice fiscale e partita IVA'
	: 'Codice fiscale';

// Un'unica fonte per i dati dell'ente: compilare settings.js e questa lista si
// aggiorna. I campi non ancora noti restano dichiarati, non spariscono.
const datiEnte = [
	{ voce: 'Denominazione', valore: settings.title },
	{ voce: 'Sede legale', valore: settings.sedeLegale },
	{ voce: etichettaCf, valore: cf },
	{ voce: 'Iscrizione al RUNTS', valore: settings.runts },
	{ voce: 'PEC', valore: settings.pec, tipo: 'email' },
	{ voce: 'Email', valore: settings.email, tipo: 'email' },
];

const seo = {
	title: 'Note legali e privacy | Corpo Bandistico di Castelcovati',
	description:
		'Dati dell’associazione, informativa privacy e note legali del Corpo Bandistico di Castelcovati APS.',
};
---

<Layout seo={seo}>
	<TextSection narrow>
		<p class="eyebrow">Informazioni</p>
		<h1>Note legali e privacy</h1>

		<p class="legal__notice">
			Questa pagina è in corso di redazione. I dati e i testi qui sotto vanno
			completati dall’associazione prima della pubblicazione del sito.
		</p>

		<h2>Dati dell’associazione</h2>
		<dl class="legal__dati">
			{
				datiEnte.map(riga => (
					<div class="legal__riga">
						<dt>{riga.voce}</dt>
						<dd class:list={['tabular', { 'is-vuoto': !riga.valore }]}>
							{
								riga.valore && riga.tipo === 'email' ? (
									<a href={`mailto:${riga.valore}`}>{riga.valore}</a>
								) : (
									riga.valore || '— da inserire'
								)
							}
						</dd>
					</div>
				))
			}
		</dl>

		<h2>Titolare del trattamento dei dati</h2>
		<p>
			Da inserire: chi è il titolare del trattamento e a quale indirizzo si
			possono esercitare i diritti previsti dal GDPR.
		</p>

		<h2>Dati raccolti dal sito</h2>
		<p>
			Da inserire: quali dati raccoglie il modulo contatti, per quale finalità
			vengono usati, per quanto tempo sono conservati e a chi vengono
			comunicati. Vanno indicati anche i servizi esterni utilizzati (per
			esempio il portale soci WindDoc) e il relativo trattamento.
		</p>

		<h2>Cookie</h2>
		<p>
			Da inserire: elenco dei cookie e degli strumenti di misurazione
			eventualmente attivi. Se verranno introdotti cookie non tecnici sarà
			necessario anche un banner di consenso, al momento non presente.
		</p>

		<h2>Diritti dell’interessato</h2>
		<p>
			Da inserire: come richiedere accesso, rettifica, cancellazione o
			limitazione del trattamento dei propri dati.
		</p>
	</TextSection>
</Layout>

<style>
	.legal__notice {
		padding: var(--nota-padding);
		border-left: 3px solid var(--theme-accent);
		background-color: var(--theme-surface-1);
		border-radius: var(--radius-sm);
		color: var(--theme-on-surface-1);
		max-width: none;
	}
	.legal__dati {
		margin: 0 0 var(--space-lg);
		border-top: 1px solid var(--theme-border);
	}
	.legal__riga {
		display: grid;
		grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
		gap: var(--space-sm);
		padding: var(--space-2xs) 0;
		border-bottom: 1px solid var(--theme-border);
	}
	.legal__riga dt {
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	.legal__riga dd {
		margin: 0;
		font-variant-numeric: tabular-nums;
	}
	.legal__riga dd.is-vuoto {
		color: var(--theme-muted);
		font-style: italic;
	}
	@media (max-width: 640px) {
		.legal__riga {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
