---
import ContactForm from '../../components/forms/ContactForm.astro';
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';
import settings from '../../config/settings.js';

// Recapiti da settings.js: erano scritti a mano qui e nelle note legali,
// due copie che potevano divergere.
const telefono = '+39 371 771 1684';

const seo = {
	title: 'Contatti | Corpo Bandistico di Castelcovati',
	description: 'Scrivici per informazioni su concerti, servizi, scuola di musica o per proporci una collaborazione.',
};
---

<Layout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1>Contattaci</h1>
				<p>
				    Compila il seguente form.</br>
					Saremo felici di rispondere a qualsiasi dubbio tu possa incontrare.</br></br>
					Ti forniremo tutte le informazioni di cui necessiti.</br></br>
					In alternativa puoi sempre contattarci ai seguenti recapiti:
				</p>
				<ul class="contact-hero__recapiti">
					<li>
						<a href={`tel:${telefono.replace(/\s/g, '')}`} class="tabular">{telefono}</a>
					</li>
					<li>
						<a href={`mailto:${settings.email}`}>{settings.email}</a>
					</li>
					<li>
						<span class="contact-hero__etichetta">PEC</span>
						<a href={`mailto:${settings.pec}`}>{settings.pec}</a>
					</li>
					<li class="contact-hero__sede">{settings.sedeLegale}</li>
				</ul>
			</div>
			<div class="col-2__container">
				<ContactForm />
			</div>
		</section>
	</Container>
</Layout>

<style>
	.contact-hero__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: calc(90vh - var(--navbar-height));
		gap: 3rem;
	}
	.contact-hero__text-section {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.col-2__container {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	@media (max-width: 768px) {
		.contact-hero__section {
			grid-template-columns: 1fr;
		}
	}
	.contact-hero__recapiti {
		list-style: none;
		margin: var(--space-md) 0 0;
		padding: 0;
		max-width: none;
	}
	.contact-hero__recapiti li {
		max-width: none;
		padding: var(--space-3xs) 0;
		font-size: var(--font-size-sm);
	}
	.contact-hero__recapiti a {
		text-underline-offset: 0.2em;
	}
	.contact-hero__etichetta {
		display: inline-block;
		min-width: 2.6rem;
		font-size: var(--font-size-xs);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--theme-muted);
	}
	.contact-hero__sede {
		color: var(--theme-muted);
		padding-top: var(--space-2xs);
	}
</style>
