---
import { Container, Button } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import TextAndImageHero from '../../components/sections/heros/TextAndImageHero.astro';
import HeroSlider from '../../components/sections/heros/HeroSlider.astro';

const seo = {
  title: 'Trasparenza | Corpo Bandistico di Castelcovati ',
  description:
    'Elenco dei contributi e finanziamenti pubblici ricevuti dal Corpo Bandistico di Castelcovati, ai sensi della normativa sulla trasparenza.',
};

// riuso ESATTO del blocco heroImages della home
const heroImages = [
  {
    src: '/assets/images/hero-trasp.jpeg',
    alt: 'Banda hero 1',
  },
];

// Elenco dei contributi pubblici da pubblicare.
// I dati reali verranno inseriti in seguito: lasciare l'array vuoto finché
// non sono disponibili (la tabella mostra un avviso al posto delle righe).
// In seguito si può caricarlo da JSON/API o da file CSV.
//
// Struttura di ogni riga (esempio commentato come modello):
// {
//   anno: 2024,
//   enteErogante: 'Comune di Castelcovati',
//   causale: 'Contributo annuale attività musicale',
//   importo: 3000.0,
//   dataIncasso: '2024-03-15',
//   estremiAtto: 'Delibera n. 12 del 10/03/2024',
// },
const contributiPubblici = [];
---

<Layout {seo}>
  <TextAndImageHero reversed>
    <div slot="text-container">
      <h1>Trasparenza</h1>
      <p>
        In questa pagina pubblichiamo i contributi e i finanziamenti pubblici
        ricevuti dal Corpo Bandistico di Castelcovati, in ottemperanza agli
        obblighi di trasparenza e pubblicità.
      </p>
    </div>

    <div slot="btns-container">
      <Button href="/company/about" outlined>
        Chi siamo
      </Button>
    </div>

    <HeroSlider slot="image-container" images={heroImages} interval={10000} />
  </TextAndImageHero>

  <Container>
    <section class="trasparenza">
      <header class="trasparenza__header">
        <h2>Contributi e finanziamenti pubblici</h2>
        <p>
          Di seguito sono riportate le informazioni relative a sovvenzioni,
          contributi, incarichi retribuiti e comunque vantaggi economici di
          qualunque genere ricevuti da pubbliche amministrazioni e soggetti
          assimilati.
        </p>
      </header>

      <div class="trasparenza__table-wrapper">
        <table class="trasparenza__table">
          <thead>
            <tr>
              <th>Anno</th>
              <th>Ente erogante</th>
              <th>Causale</th>
              <th>Importo</th>
              <th>Data incasso</th>
              <th>Estremi atto</th>
            </tr>
          </thead>
          <tbody>
            {contributiPubblici.length === 0 ? (
              <tr>
                <td colspan="6" class="trasparenza__empty">
                  Dati in fase di inserimento.
                </td>
              </tr>
            ) : (
              contributiPubblici.map((riga) => (
                <tr>
                  <td>{riga.anno}</td>
                  <td>{riga.enteErogante}</td>
                  <td>{riga.causale}</td>
                  <td>
                    {riga.importo.toLocaleString('it-IT', {
                      style: 'currency',
                      currency: 'EUR',
                    })}
                  </td>
                  <td>
                    {new Date(riga.dataIncasso).toLocaleDateString('it-IT')}
                  </td>
                  <td>{riga.estremiAtto}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <p class="trasparenza__note">
        I dati sopra riportati sono aggiornati alla data indicata
        nell&apos;ultimo bilancio approvato.
      </p>
    </section>
  </Container>
</Layout>

<style>
  .trasparenza {
    margin: var(--section-margin) auto;
  }

  .trasparenza__header {
    margin-bottom: var(--space-md);
    max-width: 56rem;
  }

  .trasparenza__header h2 {
    margin-bottom: var(--space-2xs);
  }

  .trasparenza__header p {
    color: var(--theme-on-surface-2);
    line-height: 1.6;
  }

  .trasparenza__table-wrapper {
    margin-top: var(--space-sm);
    border-radius: var(--radius-lg);
    background: var(--theme-surface-1);
    box-shadow: var(--theme-elevation-1);
    padding: var(--blocco-padding);
    overflow-x: auto; /* per mobile */
  }

  .trasparenza__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .trasparenza__table thead {
    background: var(--theme-surface-2);
  }

  .trasparenza__table th,
  .trasparenza__table td {
    padding: var(--space-2xs) var(--space-xs);
    text-align: left;
    border-bottom: 1px solid var(--theme-border);
  }

  .trasparenza__table th {
    font-weight: 600;
    white-space: nowrap;
  }

  .trasparenza__table tbody tr:nth-child(even) {
    background: var(--theme-surface-1);
  }

  .trasparenza__empty {
    text-align: center;
    font-style: italic;
    color: var(--theme-on-surface-2);
  }

  .trasparenza__note {
    margin-top: var(--space-xs);
    font-size: 0.9rem;
    color: var(--theme-on-surface-2);
  }

  @media (max-width: 768px) {
    .trasparenza__table th,
    .trasparenza__table td {
      padding: var(--space-2xs);
      font-size: 0.9rem;
    }
  }
</style>
