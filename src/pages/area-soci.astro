---
import { Icon } from 'astro-icon/components';
import { Button, Container, TextCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Area soci | Corpo Bandistico di Castelcovati',
	description: 'Accedi al portale riservato ai soci: ricevute, documenti condivisi, stato associativo e votazioni.',
};
---

<Layout {seo}>
	<Container>
		<TextCardSection>
			<h1>Area soci</h1>
			<p>
				Utilizza il pulsante sottostante per accedere alla tua area personale.
				Dalla tua area personale potrai:
				<li>Visionare tutte le tue ricevute e tutti i tuoi documenti;</li>
				<li>Accedere a tutti i documenti condivisi;</li>
				<li>Visionare il tuo stato di socio;</li>
				<li>
					Partecipare ad eventuali votazioni attivate dal Consiglio Direttivo;
				</li>
			</p>
			<br></br>

			<div class="cta-buttons__container">
				<Button
					href="https://soci.winddoc.com/login.php"
					newTab
					customIcon
				>
					Accedi al portale dedicato
					<Fragment slot="icon">
						<Icon name="ic:baseline-launch" />
					</Fragment>
				</Button>
				<Button
					href="https://app.winddoc.com/short/2137/"
					newTab
					customIcon
					outlined
				>
					Non sei socio? Registrati qui!
					<Fragment slot="icon">
						<Icon name="ic:baseline-chevron-right" />
					</Fragment>
				</Button>
			</div>
		</TextCardSection>
	</Container>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: var(--space-sm);
	}
</style>
