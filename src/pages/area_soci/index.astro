---
import { Icon } from 'astro-icon/components';
import { Button, Container, TextCardSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
	title: 'private dedicated area',
	description: 'Go to private area.',
};
---

<Layout {seo}>
	<Container>
		<TextCardSection>
			<h1>Area soci</h1>
			<div class="cta-buttons__container">
				<Button
					href="https://soci.winddoc.com/login.php"
					outlined
					newTab
					customIcon
				>
					Accedi al portale dedicato
					<Fragment slot="icon">
						<Icon name="ic:baseline-launch" />
					</Fragment>
				</Button>
				<Button href="/theme/theme-setup" customIcon>
					Theme Setup
					<Fragment slot="icon">
						<Icon name="ic:baseline-chevron-right" />
					</Fragment>
				</Button>
				<Button href="/theme/customizing-odyssey" customIcon>
					Customizing Odyssey
					<Fragment slot="icon">
						<Icon name="ic:baseline-chevron-right" />
					</Fragment>
				</Button>
			</div>
		</TextCardSection>
	</Container>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>
