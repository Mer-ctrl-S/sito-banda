---
import { format, isBefore } from 'date-fns';
import it from 'date-fns/locale/it/index.js';
import {
  Container,
  TextCardSection,
  Button,
} from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import NewsletterForm from '../../components/forms/NewsletterForm.astro';
import HeroSection from '../../components/sections/heros/HeroSection.astro';

import {
  WINDDOC_URL,
  TOKEN_APP,
  TOKEN_KEY,
  toFormUrlEncoded,
} from '../../lib/winddoc'; // 👈 percorso da src/pages/blog

function stripHtml(html: string): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
}

async function fetchEventi({ pagina = 1 } = {}) {
  const bodyObj = {
    method: 'associazioni_eventi_lista',
    request: {
      token_key: {
        token: TOKEN_KEY,
        token_app: TOKEN_APP,
      },
      // query: 'data_evento > NOW()', // ❌ togli il filtro qui
      pagina,
    },
  };

  const res = await fetch(WINDDOC_URL, {
    method: 'POST',
    headers: {
      Accept: 'application/json',
      'Content-Type': 'application/x-www-form-urlencoded',
    },
    body: toFormUrlEncoded(bodyObj),
  });

  if (!res.ok) {
    throw new Error(`Errore richiesta WindDoc lista: ${res.status}`);
  }

  const data = await res.json();
  return data;
}

let eventiLista: any[] = [];

try {
  const data = await fetchEventi({ pagina: 1 });
  if (data && data.success && Array.isArray(data.lista)) {
    eventiLista = data.lista;
  } else {
    console.warn('[WindDoc lista] struttura inattesa:', data);
  }
} catch (err) {
  console.error('[WindDoc lista] errore chiamando API:', err);
}

const eventiRaw = eventiLista.map((evento) => {
  const id = evento.id_associazione_evento;
  const titolo = evento.nome ?? 'Evento senza titolo';
  const descrizioneHtml = evento.descrizione ?? '';
  const descrizioneTesto = stripHtml(descrizioneHtml);
  const luogo = evento.indirizzo ?? '';
  const rawDate = evento.data_evento;
  const dateObj = rawDate ? new Date(rawDate) : null;

  const image =
      evento.logo &&
      typeof evento.logo === 'object' &&
      'link' in evento.logo
        ? (evento.logo as any).link
        : null;

  return {
    id,
    title: titolo,
    descriptionHtml: descrizioneHtml,
    descriptionText: descrizioneTesto,
    place: luogo,
    date: dateObj,
    image,
    href: id ? `/blog/eventi/${id}` : null,
  };
});

// Filtra solo quelli con una data valida
const now = new Date();

const eventiFuturi = eventiRaw
  .filter((e) => e.date && e.date >= now)
  .sort((a, b) => (a.date! > b.date! ? 1 : -1)); // dal più vicino al più lontano

const eventiPassati = eventiRaw
  .filter((e) => e.date && e.date < now)
  .sort((a, b) => (a.date! > b.date! ? -1 : 1)); // dal più recente al più vecchio

const seo = {
  title: 'Blog & Eventi | Corpo Bandistico di Castelcovati',
  description:
    'Notizie ed eventi del Corpo Bandistico di Castelcovati, aggiornati automaticamente tramite WindDoc.',
};
---

<Layout {seo}>
  <HeroSection>
    <div slot="text-container">
      <h1>Eventi</h1>
      <p>
        Scopri i prossimi appuntamenti del Corpo Bandistico di Castelcovati
        e ripercorri gli eventi passati.
      </p>
    </div>

    <div slot="image-container">
      <img
        src="assets/images/hero-event-list.jpeg"
        alt="Concerto del Corpo Bandistico di Castelcovati"
        loading="lazy"
        decoding="async"
      />
    </div>
  </HeroSection>

  <Container>
    <section class="eventi-lista">
      {eventiFuturi.length > 0 && (
        <>
          <h2>Prossimi eventi</h2>

          {eventiFuturi.map((evento) => (
            <article class="evento-card">
              <div class="evento-card__inner">
                {evento.image && (
                  <div class="evento-card__media">
                    <img
                      src={evento.image}
                      alt={evento.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}

                <div class="evento-card__body">
                  <h3 class="evento-card__title">{evento.title}</h3>

                  {evento.date && (
                    <p class="evento-card__meta">
                      {format(
                        evento.date,
                        "EEEE d MMMM yyyy",
                        { locale: it }
                      )}
                      {evento.place && ` · ${evento.place}`}
                    </p>
                  )}

                  {evento.descriptionText && (
                    <p class="evento-card__description">
                      {evento.descriptionText.length > 200
                        ? evento.descriptionText.slice(0, 200) + '…'
                        : evento.descriptionText}
                    </p>
                  )}

                  {evento.href && (
                    <div class="evento-card__actions">
                      <Button href={evento.href} outlined>
                        Dettagli
                      </Button>
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </>
      )}

      {eventiPassati.length > 0 && (
        <>
          <h2>Eventi passati</h2>

          {eventiPassati.map((evento) => (
            <article class="evento-card">
              <div class="evento-card__inner">
                {evento.image && (
                  <div class="evento-card__media">
                    <img
                      src={evento.image}
                      alt={evento.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}

                <div class="evento-card__body">
                  <h3 class="evento-card__title">{evento.title}</h3>

                  {evento.date && (
                    <p class="evento-card__meta">
                      {format(
                        evento.date,
                        "EEEE d MMMM yyyy",
                        { locale: it }
                      )}
                      {evento.place && ` · ${evento.place}`}
                    </p>
                  )}

                  {evento.descriptionText && (
                    <p class="evento-card__description">
                      {evento.descriptionText.length > 200
                        ? evento.descriptionText.slice(0, 200) + '…'
                        : evento.descriptionText}
                    </p>
                  )}

                  {evento.href && (
                    <div class="evento-card__actions">
                      <Button href={evento.href} outlined>
                        Dettagli
                      </Button>
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </>
      )}
    </section>
  </Container>
</Layout>

<style>
.evento-card {
  border-radius: var(--theme-shape-radius);
  background: var(--theme-surface);
  box-shadow: var(--theme-elevation-1);
  padding: 1.5rem;
  margin: 0 0 1.5rem;
}

.evento-card__inner {
  display: flex;
  gap: 1.5rem;
}

/* colonna immagine */
.evento-card__media {
  flex: 0 0 180px;
  max-width: 180px;
  border-radius: var(--theme-shape-radius);
  overflow: hidden;
  align-self: flex-start;
}

.evento-card__media img {
  display: block;
  width: 100%;
  height: 180px;
  object-fit: cover;  /* usa contain se vuoi l'immagine intera */
}

/* colonna testo */
.evento-card__body {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.evento-card__title {
  margin: 0;
}

.evento-card__meta {
  font-size: 0.95rem;
  color: var(--theme-on-surface-2);
  margin: 0;
}

.evento-card__description {
  margin: 0.25rem 0 0.75rem;
}

.evento-card__actions {
  margin-top: auto;
}

/* Responsive */
@media (max-width: 700px) {
  .evento-card__inner {
    flex-direction: column;
  }

  .evento-card__media {
    flex: 0 0 auto;
    max-width: 100%;
  }

  .evento-card__media img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
}

.evento-card {
  border-radius: var(--theme-shape-radius);
  background: var(--theme-surface-1);       /* 👈 livello diverso dallo sfondo */
  box-shadow: var(--theme-elevation-1);
  padding: 1.5rem;
  margin: 0 0 1.5rem;
  border: 1px solid rgba(0, 0, 0, 0.03);    /* leggero bordo per staccare */
}
</style>
