---
import { Icon } from 'astro-icon/components';
import Layout from '../../../layouts/Page.astro';
import { Container, Button } from '@components/odyssey-theme';
import BandaChart from '../../../components/BandaChart.astro';
import TextAndImageHero from '../../../components/sections/heros/TextAndImageHero.astro';
import HeroSlider from '../../../components/sections/heros/HeroSlider.astro';
import {
	corsiPerSlug,
	corsiStrumento,
	corsiAltri,
	corsiCollettivi,
	daConfermare,
	formattaPrezzo,
	alMese,
	DURATA_PREDEFINITA,
	DA_CONFERMARE,
} from '../../../config/corsi.js';
import { soundMap, soundMapSettore } from '../../../config/suoni.js';

const seo = {
	title: 'I nostri corsi | Corpo Bandistico di Castelcovati',
	description:
		'Gli strumenti della banda, la musica d\u2019insieme e il corso di teoria e solfeggio: ascolta ogni strumento e apri la scheda del corso.',
};

// riuso delle immagini hero della sezione "scuola" per coerenza visiva
const heroImages = [
	{
		src: '/assets/images/hero-school-1.jpeg',
		alt: "Allievi dell'Accademia Musicale durante una lezione",
	},
	{
		src: '/assets/images/hero-school-2.jpeg',
		alt: "Allievi dell'Accademia Musicale durante una lezione",
	},
];

// definizione settori (angoli in gradi, 180\u00b0 = lato sinistro, 0\u00b0 = lato destro)
const sections = [
	// ANELLO 1 (interno, vicino al direttore)
	{ id: 'C1', label: 'Clarinetto', ring: 1, startDeg: 180, endDeg: 265 },
	{ id: 'OB', label: 'Oboe', ring: 1, startDeg: 265, endDeg: 280 },
	{ id: 'Flute1', label: 'Flauto Traverso', ring: 1, startDeg: 280, endDeg: 340 },
	{ id: 'Ottavino', label: 'Ottavino', ring: 1, startDeg: 340, endDeg: 360 },

	// ANELLO 2 (medio, legni/ottoni centrali)
	{ id: 'Clar2', label: 'Clarinetto', ring: 2, startDeg: 180, endDeg: 195 },
	{ id: 'CB', label: 'Clar. Basso', ring: 2, startDeg: 195, endDeg: 230 },
	{ id: 'Corno', label: 'Corno Francese', ring: 2, startDeg: 245, endDeg: 270 },
	{ id: 'BSN', label: 'Fagotto', ring: 2, startDeg: 230, endDeg: 245 },
	{ id: 'SAXB', label: 'Sax Baritono', ring: 2, startDeg: 270, endDeg: 290 },
	{ id: 'SaxTen', label: 'Sax Tenore', ring: 2, startDeg: 290, endDeg: 310 },
	{ id: 'SaxContr', label: 'Sax Contralto', ring: 2, startDeg: 310, endDeg: 360 },

	// ANELLO 3 (esterno, grande ventaglio)
	{ id: 'Perc', label: 'Percussioni', ring: 3, startDeg: 180, endDeg: 240 },
	{ id: 'Tromba', label: 'Tromba', ring: 3, startDeg: 240, endDeg: 270 },
	{ id: 'Tuba', label: 'Tuba', ring: 3, startDeg: 270, endDeg: 290 },
	{ id: 'Euph', label: 'Euphonium', ring: 3, startDeg: 290, endDeg: 310 },
	{ id: 'Trombone', label: 'Trombone', ring: 3, startDeg: 310, endDeg: 360 },
];

// Ogni settore del grafico punta a un corso in config/corsi.js.
const settoreVersoSlug = {
	C1: 'clarinetto',
	Clar2: 'clarinetto',
	CB: 'clarinetto-basso',
	OB: 'oboe',
	BSN: 'fagotto',
	Flute1: 'flauto',
	Ottavino: 'ottavino',
	Corno: 'corno',
	Tromba: 'tromba',
	Trombone: 'trombone',
	SaxContr: 'sax-contralto',
	SaxTen: 'sax-tenore',
	SAXB: 'sax-baritono',
	Perc: 'percussioni',
	Tuba: 'tuba',
	Euph: 'euphonium',
};

/**
 * Quota in una riga sola per il modale. `corso.costo` non e' mai esistito in
 * corsi.js, quindi quella riga usciva sempre vuota: qui si ricava dai dati veri,
 * gli stessi che la pagina del corso mostra come prezzo di apertura.
 * "da", perche' e' la durata di lezione piu' breve fra le tre.
 */
function quotaSintetica(corso) {
	const annuale = corso.prezzi
		? corso.prezzi[DURATA_PREDEFINITA]
		: corso.quotaAnnuale;
	if (typeof annuale !== 'number') return DA_CONFERMARE;
	return `da ${formattaPrezzo(alMese(annuale))} al mese`;
}

/**
 * L'organico raggruppato per famiglia. L'icona e' per famiglia e non per
 * strumento: lucide non ha un clarinetto o una tuba, e ripetere la stessa
 * notina venti volte sarebbe decorazione. Cosi' invece dice qualcosa.
 */
const FAMIGLIE = [
	{ chiave: 'legni', etichetta: 'Legni', icona: 'lucide:wind' },
	{ chiave: 'ottoni', etichetta: 'Ottoni', icona: 'lucide:megaphone' },
	{ chiave: 'percussioni', etichetta: 'Percussioni', icona: 'lucide:drum' },
];

const famiglieStrumenti = FAMIGLIE.map(famiglia => ({
	...famiglia,
	corsi: corsiStrumento.filter(corso => corso.famiglia === famiglia.chiave),
})).filter(famiglia => famiglia.corsi.length > 0);

// Dati passati al modal: nessun campo inventato, i segnaposto arrivano cos\u00ec come sono.
const instrumentData = Object.fromEntries(
	sections.map(settore => {
		const corso = corsiPerSlug[settoreVersoSlug[settore.id]];
		return [
			settore.id,
			{
				nome: corso.nome,
				href: corso.href,
				immagine: corso.immagine,
				suono: soundMapSettore[settore.id] ?? soundMap[corso.slug] ?? null,
				scheda: [
					{ voce: 'Insegnante', valore: corso.insegnante, vuoto: daConfermare(corso.insegnante) },
					{ voce: 'Orari', valore: corso.orari, vuoto: daConfermare(corso.orari) },
					{
						voce: 'Quota',
						valore: quotaSintetica(corso),
						vuoto: daConfermare(quotaSintetica(corso)),
					},
				],
			},
		];
	})
);
---

<Layout {seo}>
	<TextAndImageHero reversed>
		<div slot="text-container">
			<h1>I nostri corsi</h1>
			<p>
				La nostra accademia è aperta a bambini, ragazzi e adulti che vogliono
				scoprire il piacere di suonare uno strumento e far parte della banda
				musicale. Che tu parta da zero o voglia perfezionarti, troverai lezioni
				su misura per te.
			</p>
		</div>

		<div slot="btns-container">
			<Button href="#banda-interattiva" outlined>Scopri gli strumenti</Button>
		</div>

		<HeroSlider slot="image-container" images={heroImages} interval={10000} />
	</TextAndImageHero>

	<Container>
		<!-- INTRO SEZIONE BANDA -->
		<section class="intro-card">
			<div class="intro-card__content">
				<h2>Scopri la Banda Musicale</h2>
				<p>
					Nella grafica qui sotto trovi la disposizione reale dei musicisti sul
					palco. Clicca sulle sezioni per ascoltare il suono degli strumenti e
					capire quale ti ispira di più.
				</p>
				<p class="intro-card__hint">
					Suggerimento: prova a confrontare i legni (flauti, clarinetti, sax)
					con gli ottoni (trombe, tromboni, corni, tuba) e le percussioni, così
					ti fai un’idea delle diverse famiglie strumentali.
				</p>
			</div>
		</section>

		<!-- BANDA INTERATTIVA -->
		<section id="banda-interattiva" class="banda-section">
			<div class="banda-section__header">
				<h3>La banda vista dal direttore</h3>
				<p>
					Ogni “spicchio” rappresenta una sezione di strumenti: cliccando, puoi
					ascoltare un breve estratto audio registrato dai nostri musicisti.
				</p>
			</div>

			<div class="banda-svg-wrapper">
				<!-- BandaChart deve generare l'SVG con id="bandaSvg" e i settori cliccabili -->
				<BandaChart {sections} />
			</div>
		</section>

		<!-- ELENCO DELL'ORGANICO: il grafico e' il modo bello di arrivarci, questo e'
		     quello raggiungibile da tastiera, dai lettori di schermo e dai motori di
		     ricerca. Sta subito sotto al grafico perche' e' la stessa informazione. -->
		<section class="organico" aria-labelledby="organicoTitolo">
			<h2 id="organicoTitolo">Tutti i corsi di strumento</h2>
			<p class="organico__intro">
				Gli strumenti dell’organico, famiglia per famiglia. Ognuno ha la sua
				pagina, con insegnante, quota e come funziona il corso.
			</p>

			{
				famiglieStrumenti.map(famiglia => (
					<div class="organico__famiglia">
						<h3 class="organico__nome">
							<Icon name={famiglia.icona} width="20" height="20" aria-hidden="true" />
							<span>{famiglia.etichetta}</span>
						</h3>
						<ul class="organico__lista">
							{famiglia.corsi.map(corso => (
								<li>
									<a href={corso.href}>{corso.nome}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</section>

		<!-- STRUMENTI FUORI DALL'ORGANICO: insegnati dalla scuola, assenti dal grafico -->
		<section class="altri" aria-labelledby="altriTitolo">
			<h2 id="altriTitolo">Altri strumenti</h2>
			<p class="altri__intro">
				Non fanno parte dell’organico della banda, ma si studiano nella nostra
				scuola con lo stesso percorso e gli stessi insegnanti.
			</p>

			<ul class="altri__lista">
				{
					corsiAltri.map(corso => (
						<li class="altri__voce">
							<h3><a href={corso.href}>{corso.nome}</a></h3>
							<p>{corso.descrizione}</p>
							{corso.insegnante !== '— da confermare' && (
								<p class="altri__insegnante">{corso.insegnante}</p>
							)}
						</li>
					))
				}
			</ul>
		</section>

		<!-- CORSI COLLETTIVI: non stanno sul grafico perché non sono strumenti -->
		<section class="collettivi" aria-labelledby="collettiviTitolo">
			<h2 id="collettiviTitolo">Non solo strumenti</h2>
			<p class="collettivi__intro">
				Corsi che non compaiono nel grafico perché non sono legati a un
				singolo strumento, ma accompagnano lo studio di tutti.
			</p>

			<ul class="collettivi__lista">
				{
					corsiCollettivi.map(corso => (
						<li class="collettivi__voce">
							<h3><a href={corso.href}>{corso.nome}</a></h3>
							<p>{corso.descrizione}</p>
						</li>
					))
				}
			</ul>
		</section>

		<!-- BLOCCO FINALE: manda al regolamento, dove c'è tutto il resto -->
		<section class="cta-section">
			<div class="cta-section__content">
				<h2>Prima di iscriverti</h2>
				<p>
					Ti invitiamo a <strong>leggere il regolamento</strong>.</br>
					Qui puoi trovare tutte le informazioni generali in merito alla scuola.
					Trovi anche informazioni riguardanti il prestito degli strumenti, come si paga e le varie regole di frequenza.
				</p>
				<div class="cta-section__azione">
					<Button href="/scuola/regolamento">Leggi il regolamento dei corsi</Button>
				</div>
				<p class="cta-section__reg">
					Non sai da dove partire? <a href="/company/contact">Scrivici</a>: ti
					aiutiamo a capire quale corso è più adatto in base all’età, ai gusti
					musicali e al tempo che puoi dedicare allo studio.
				</p>
			</div>
		</section>
	</Container>

	<!-- MODAL STRUMENTO -->
	<div id="instrumentModal" class="instrument-modal" hidden>
		<div class="instrument-modal__backdrop" data-close></div>
		<div
			class="instrument-modal__box"
			role="dialog"
			aria-modal="true"
			aria-labelledby="instrumentModalTitle"
		>
			<div class="instrument-modal__intestazione">
				<h2 id="instrumentModalTitle" class="instrument-modal__title"></h2>
				<button
					type="button"
					class="instrument-modal__close"
					data-close
					aria-label="Chiudi"
				>
					<Icon name="lucide:x" width="20" height="20" aria-hidden="true" />
				</button>
			</div>

			<div class="instrument-modal__media">
				<img id="instrumentModalImage" class="instrument-modal__image" alt="" hidden />
				<div id="instrumentModalPlaceholder" class="instrument-modal__placeholder">
					<Icon name="lucide:music" width="48" height="48" aria-hidden="true" />
				</div>
			</div>

			<button type="button" id="instrumentModalAudio" class="instrument-modal__audio" aria-pressed="false">
				<Icon
					class="instrument-modal__audio-icona instrument-modal__audio-icona--play"
					name="lucide:play"
					width="18"
					height="18"
					aria-hidden="true"
				/>
				<Icon
					class="instrument-modal__audio-icona instrument-modal__audio-icona--pausa"
					name="lucide:pause"
					width="18"
					height="18"
					aria-hidden="true"
				/>
				<span id="instrumentModalAudioLabel">Ascolta</span>
			</button>
			<p id="instrumentModalNote" class="instrument-modal__note" hidden>Audio in arrivo</p>

			<dl id="instrumentModalScheda" class="instrument-modal__scheda"></dl>

			<a id="instrumentModalLink" class="instrument-modal__link" href="#">
				<Icon name="lucide:book-open" width="18" height="18" aria-hidden="true" />
				<span>Vedi il corso completo</span>
			</a>
		</div>
	</div>

	<script define:vars={{ instrumentData }}>
		const svg = document.getElementById('bandaSvg');
		const modal = document.getElementById('instrumentModal');
		const box = modal?.querySelector('.instrument-modal__box');
		const modalImage = document.getElementById('instrumentModalImage');
		const modalPlaceholder = document.getElementById('instrumentModalPlaceholder');
		const modalTitle = document.getElementById('instrumentModalTitle');
		const modalNote = document.getElementById('instrumentModalNote');
		const audioBtn = document.getElementById('instrumentModalAudio');
		const audioLabel = document.getElementById('instrumentModalAudioLabel');
		const scheda = document.getElementById('instrumentModalScheda');
		const link = document.getElementById('instrumentModalLink');
		const audio = new Audio();
		audio.preload = 'auto';

		let ultimoTrigger = null;

		// L'icona dice "pausa", quindi il pulsante mette davvero in pausa: alla
		// ripresa riparte da dove era. Il brano torna all'inizio quando finisce
		// e quando si apre la scheda di un altro strumento.
		function fermaAudio() {
			audio.pause();
			audioBtn.setAttribute('aria-pressed', 'false');
			audioLabel.textContent = 'Ascolta';
		}

		function avviaAudio() {
			audio.play().then(
				() => {
					audioBtn.setAttribute('aria-pressed', 'true');
					audioLabel.textContent = 'Pausa';
				},
				() => fermaAudio()
			);
		}

		audio.addEventListener('ended', () => {
			audio.currentTime = 0;
			fermaAudio();
		});
		audio.addEventListener('error', () => {
			fermaAudio();
			modalNote.hidden = false;
			modalNote.textContent = 'Audio non disponibile al momento';
		});
		audioBtn.addEventListener('click', () => {
			if (audioBtn.getAttribute('aria-pressed') === 'true') fermaAudio();
			else avviaAudio();
		});

		function closeModal() {
			modal.hidden = true;
			document.body.style.overflow = '';
			fermaAudio();
			// il focus torna al settore da cui si è partiti
			if (ultimoTrigger && typeof ultimoTrigger.focus === 'function') {
				ultimoTrigger.focus();
			}
		}

		function openModalFor(id, trigger) {
			const data = instrumentData[id];
			if (!data) return;

			ultimoTrigger = trigger ?? null;
			modalTitle.textContent = data.nome;
			link.href = data.href;

			modalImage.hidden = false;
			modalPlaceholder.hidden = true;
			modalImage.alt = data.nome;
			modalImage.onerror = () => {
				modalImage.hidden = true;
				modalPlaceholder.hidden = false;
			};
			modalImage.src = data.immagine;

			// scheda sintetica: i segnaposto restano visibili e dichiarati
			scheda.replaceChildren();
			data.scheda.forEach(riga => {
				const dt = document.createElement('dt');
				dt.textContent = riga.voce;
				const dd = document.createElement('dd');
				dd.textContent = riga.valore;
				if (riga.vuoto) dd.classList.add('is-vuoto');
				scheda.append(dt, dd);
			});

			fermaAudio();
			modalNote.textContent = 'Audio in arrivo';
			if (data.suono) {
				modalNote.hidden = true;
				audioBtn.hidden = false;
				audio.src = data.suono;
			} else {
				audio.removeAttribute('src');
				audioBtn.hidden = true;
				modalNote.hidden = false;
			}

			modal.hidden = false;
			document.body.style.overflow = 'hidden';

			// l'utente ha cliccato: l'ascolto parte, ma il pulsante lo ferma sempre
			if (data.suono) avviaAudio();
			(data.suono ? audioBtn : link).focus();
		}

		if (svg) {
			svg.querySelectorAll('.sector').forEach(sector => {
				const apri = () => {
					const id = sector.getAttribute('data-instrument');
					if (id) openModalFor(id, sector);
				};
				sector.addEventListener('click', apri);
				sector.addEventListener('keydown', e => {
					if (e.key === 'Enter' || e.key === ' ') {
						e.preventDefault();
						apri();
					}
				});
			});
		}

		if (modal) {
			modal.querySelectorAll('[data-close]').forEach(el => {
				el.addEventListener('click', closeModal);
			});

			document.addEventListener('keydown', e => {
				if (modal.hidden) return;

				if (e.key === 'Escape') {
					closeModal();
					return;
				}

				// il focus resta dentro la finestra finché è aperta
				if (e.key === 'Tab') {
					const focusabili = [...box.querySelectorAll('button, a[href]')].filter(
						el => !el.hidden && el.offsetParent !== null
					);
					if (!focusabili.length) return;
					const primo = focusabili[0];
					const ultimo = focusabili[focusabili.length - 1];
					if (e.shiftKey && document.activeElement === primo) {
						e.preventDefault();
						ultimo.focus();
					} else if (!e.shiftKey && document.activeElement === ultimo) {
						e.preventDefault();
						primo.focus();
					}
				}
			});
		}
	</script>
</Layout>

<style>
	/* HERO */
	/* INTRO CARD */
	.intro-card {
		margin: var(--space-lg) auto var(--space-lg);
		max-width: 52rem;
		text-align: center;
	}

	.intro-card__content {
		padding: var(--space-md) var(--space-sm);
	}

	.intro-card__hint {
		margin-top: var(--space-xs);
		color: var(--theme-on-surface-2);
	}

	/* BANDA SECTION */
	.banda-section {
		margin: 0 0 3rem;
	}

	.banda-section__header {
		text-align: center;
		max-width: 42rem;
		margin: 0 auto 1.5rem;
	}

	.banda-section__header h3 {
		margin-bottom: var(--space-2xs);
	}

	.banda-svg-wrapper {
		max-width: 920px;
		margin: 0 auto;
	}

	#bandaSvg {
		width: 100%;
		height: auto;
		display: block;
		margin: 0 auto;
	}

	/* CTA FINALE */
	.cta-section {
		border-top: 1px solid var(--theme-border);
		padding: var(--space-lg) 0 var(--space-xl);
		margin-top: var(--space-md);
	}

	.cta-section__content {
		max-width: 40rem;
		margin: 0 auto;
		text-align: center;
	}

	/* Il pulsante è il componente Button: prima era un <a> con stile proprio,
	   pillola a 999px e hover con filter, senza stato di focus. */
	.cta-section__azione {
		display: flex;
		justify-content: center;
		margin-top: var(--space-md);
	}

	.cta-section__reg {
		margin-top: var(--space-md);
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	/* Il paragrafo è grigio: senza questo il link ci si confondeva dentro. */
	.cta-section__reg a {
		color: var(--theme-on-bg);
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}
	.cta-section__reg a:hover {
		color: var(--theme-primary);
		text-decoration-thickness: 2px;
	}

	@media (max-width: 640px) {
		.intro-card {
			margin: var(--space-md) auto var(--space-md);
		}

		.banda-section {
			margin-bottom: var(--space-lg);
		}

		.cta-section {
			padding: var(--space-lg) 0 var(--space-lg);
		}
	}

	/* MODAL STRUMENTO */
	.instrument-modal {
		position: fixed;
		inset: 0;
		z-index: var(--z-modal);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-sm);
	}

	.instrument-modal[hidden] {
		display: none;
	}

	.instrument-modal__backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--ink) 58%, transparent);
	}

	.instrument-modal__box {
		position: relative;
		z-index: 1;
		background: var(--theme-bg);
		border-radius: var(--radius-lg);
		padding: var(--space-md);
		width: min(92vw, 26rem);
		max-height: 88dvh;
		overflow-y: auto;
		text-align: center;
		box-shadow: var(--theme-elevation-3);
	}

	/* Titolo e chiusura sulla stessa riga: il nome dello strumento e' la prima
	   cosa che si legge, sopra l'immagine. */
	.instrument-modal__intestazione {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		margin-bottom: var(--space-sm);
		text-align: left;
	}

	.instrument-modal__close {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: none;
		border-radius: 999px;
