---
import Layout from '../../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';
import BandaChart from '../../../components/BandaChart.astro';

const seo = {
	title: 'Scelta Corsi | Accademia Musicale',
	description:
		'Scopri gli strumenti della banda e ascolta il suono di ogni sezione.',
};

// definizione settori (angoli in gradi, 180° = lato sinistro, 0° = lato destro)
// layout pensato per assomigliare il più possibile allo screenshot:
// - anello 1: cerchio più vicino al direttore
// - anello 2: sedie intermedie
// - anello 3: arco esterno (percussioni, ottoni grossi, sax...)
const sections = [
	// ANELLO 1 (interno, vicino al direttore)
	// partirò dal centro e ruoto verso destra/sinistra per imitare la foto
	{ id: 'C1', label: 'C1', ring: 1, startDeg: 175, endDeg: 185 },
	{ id: 'OB', label: 'OB', ring: 1, startDeg: 185, endDeg: 200 },
	{ id: 'CB', label: 'CB', ring: 1, startDeg: 200, endDeg: 220 },
	{ id: 'BSN', label: 'BSN', ring: 1, startDeg: 220, endDeg: 240 },
	{ id: 'Clar2', label: 'Clarinetto 2', ring: 1, startDeg: 240, endDeg: 260 },
	{ id: 'Clar3', label: 'Clarinetto 3', ring: 1, startDeg: 260, endDeg: 280 },
	{ id: 'OTT', label: 'OTT', ring: 1, startDeg: 150, endDeg: 165 },
	{ id: 'Flute1', label: 'Flute1', ring: 1, startDeg: 280, endDeg: 340 },
	{ id: 'Ottavino', label: 'Ottavino', ring: 1, startDeg: 340, endDeg: 360 },

	// ANELLO 2 (medio, legni/ottoni centrali)
	{
		id: 'Flauto2',
		label: 'Flauto Traverso 2',
		ring: 2,
		startDeg: 150,
		endDeg: 170,
	},
	{ id: 'Corno', label: 'Corno Francese', ring: 2, startDeg: 190, endDeg: 210 },
	{
		id: 'SaxContr',
		label: 'Sax Contralto',
		ring: 2,
		startDeg: 210,
		endDeg: 230,
	},
	{ id: 'SaxTen', label: 'Sax Tenore', ring: 2, startDeg: 230, endDeg: 250 },
	{ id: 'SAXB', label: 'SAXB', ring: 2, startDeg: 250, endDeg: 270 },
	{ id: 'Tuba', label: 'Tuba', ring: 2, startDeg: 270, endDeg: 290 },
	{ id: 'Euph', label: 'Euphonium', ring: 2, startDeg: 290, endDeg: 310 },

	// ANELLO 3 (esterno, grande ventaglio come in screenshot)
	{ id: 'Perc', label: 'Percussioni', ring: 3, startDeg: 180, endDeg: 215 },
	{ id: 'Tromba', label: 'Tromba', ring: 3, startDeg: 215, endDeg: 240 },
	{ id: 'Trombone', label: 'Trombone', ring: 3, startDeg: 240, endDeg: 270 },
	// chiudo il lato destro con una zona trombe/tromboni “larga” come in immagine
];

// mappa strumento -> file audio
const soundMap = {
	C1: '/audio/clarinetto1.mp3',
	OB: '/audio/oboe.mp3',
	CB: '/audio/clarinetto-basso.mp3',
	BSN: '/audio/fagotto.mp3',
	Clar2: '/audio/clarinetto2.mp3',
	Clar3: '/audio/clarinetto3.mp3',
	OTT: '/audio/ottoni.mp3',
	Flute1: '/audio/flauto1.mp3',
	Flauto2: '/audio/flauto2.mp3',
	Corno: '/audio/corno.mp3',
	Tromba: '/audio/tromba.mp3',
	Trombone: '/audio/trombone.mp3',
	SaxContr: '/audio/sax-contralto.mp3',
	SaxTen: '/audio/sax-tenore.mp3',
	SAXB: '/audio/sax-baritono.mp3',
	Perc: '/audio/percussioni.mp3',
	Tuba: '/audio/tuba.mp3',
	Euph: '/audio/euphonium.mp3',
};
---

<Layout {seo}>
	<Container>
		<header class="scelta-header">
			<p class="scelta-header__eyebrow">Accademia Musicale</p>
			<h1>WIP</h1>
			<!--<h1>del Corpo Bandistico di Castelcovati</h1>
			<p class="scelta-header__subtitle">
				Un percorso formativo completo per musicisti di ogni età e livello.
			</p>
			-->
		</header>
		<!--
		<section class="banda-section">
			<div class="banda-section__text">
				<h2>Scopri la Banda Musicale</h2>
				<p class="banda-section__eyebrow">È disposta come da concerto!</p>
				<p>Clicca sulle sezioni ed ascolta gli strumenti 🎧</p>
			</div>

			<div class="banda-svg-wrapper">
				<BandaChart {sections} />
			</div>
		</section>
		-->
	</Container>

	<script>
		const soundMap = {
			C1: '/audio/clarinetto1.mp3',
			OB: '/audio/oboe.mp3',
			CB: '/audio/clarinetto-basso.mp3',
			BSN: '/audio/fagotto.mp3',
			Clar2: '/audio/clarinetto2.mp3',
			Clar3: '/audio/clarinetto3.mp3',
			OTT: '/audio/ottoni.mp3',
			Flute1: '/audio/flauto1.mp3',
			Flauto2: '/audio/flauto2.mp3',
			Corno: '/audio/corno.mp3',
			Tromba: '/audio/tromba.mp3',
			Trombone: '/audio/trombone.mp3',
			SaxContr: '/audio/sax-contralto.mp3',
			SaxTen: '/audio/sax-tenore.mp3',
			SAXB: '/audio/sax-baritono.mp3',
			Perc: '/audio/percussioni.mp3',
			Tuba: '/audio/tuba.mp3',
			Euph: '/audio/euphonium.mp3',
		};

		const svg = document.getElementById('bandaSvg');
		if (svg) {
			const audio = new Audio();
			svg.querySelectorAll('.sector').forEach(sector => {
				sector.addEventListener('click', () => {
					const id = sector.getAttribute('data-instrument');
					const src = id && soundMap[id];
					if (!src) return;
					audio.src = src;
					audio.currentTime = 0;
					audio.play();
				});
			});
		}
	</script>
</Layout>

<style>
	.scelta-header__eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		margin-bottom: 0.25rem;
	}

	.scelta-header h1 {
		margin-bottom: 0.25rem;
	}

	.scelta-header__subtitle {
		margin-top: 0.5rem;
		max-width: 32rem;
		color: var(--theme-on-surface-2);
	}

	.banda-section {
		margin: 2.5rem 0;
	}

	.banda-section__text {
		text-align: center;
		margin-bottom: 1rem;
	}

	.banda-section__eyebrow {
		font-weight: 600;
		margin: 0 0 0.25rem;
	}

	.banda-svg-wrapper {
		max-width: 800px;
		margin: 0 auto;
	}

	#bandaSvg {
		width: 100%;
		height: auto;
		display: block;
		margin: 0 auto;
	}
</style>
