---
import Layout from '../../../layouts/Page.astro';
import { Container, Button } from '@components/odyssey-theme';
import {
	corsi,
	daConfermare,
	etichettaFamiglia,
	scalaPrezzi,
	formattaPrezzo,
	DURATA_PREDEFINITA,
	DURATE,
	SCONTO_BANDA_ANNUO,
	SCONTO_FRATELLI_ANNUO,
	MESI_CORSO as MESI,
	formattaPrezzo as euro,
	alMese,
	MESI_CORSO,
} from '../../../config/corsi.js';
import { soundMap } from '../../../config/suoni.js';

export function getStaticPaths() {
	return corsi.map(corso => ({
		params: { corso: corso.slug },
		props: { corso },
	}));
}

const { corso } = Astro.props;
const suono = soundMap[corso.slug] ?? null;

const scheda = [
	{ voce: 'Insegnante', valore: corso.insegnante },
	{ voce: 'Orario delle lezioni', valore: corso.orari },
	{ voce: 'Età consigliata', valore: corso.eta },
];

// Prezzo mostrato di default: la durata più breve. La scala completa sta nel modal.
const scala = scalaPrezzi(corso);
const rigaPredefinita = scala.find(r => r.minuti === DURATA_PREDEFINITA);
const durataPredefinita = DURATE.find(d => d.minuti === DURATA_PREDEFINITA);
const haPrezzi = corso.prezzi !== null;
const haQuota = corso.quotaAnnuale !== null;
const risparmioMese = alMese(SCONTO_BANDA_ANNUO);
const risparmioFratelliMese = alMese(SCONTO_FRATELLI_ANNUO);

// La quota conta come campo: senza, l'avviso diceva "nessuna informazione
// pubblicata" anche quando il prezzo era già a schermo.
const totaleCampi = scheda.length + 1;
const mancanti =
	scheda.filter(r => daConfermare(r.valore)).length +
	(haPrezzi || haQuota ? 0 : 1);

const seo = {
	// Il suffisso lungo mandava oltre i 65 caratteri i corsi dal nome esteso
	// (propedeutico arrivava a 78): Google li tronca.
	title: `${corso.nome} | Accademia Musicale di Castelcovati`,
	description: corso.descrizione.slice(0, 155),
};
---

<Layout {seo}>
	<Container>
		<article class="corso">
			<nav class="corso__back" aria-label="Percorso">
				<a href="/scuola/corsi">← Tutti i corsi</a>
			</nav>

			<header class="corso__header">
				<h1>{corso.nome}</h1>
				<p class="corso__famiglia">{etichettaFamiglia[corso.famiglia]}</p>
				<p class="corso__descrizione">{corso.descrizione}</p>
			</header>

			{
				corso.immagine && (
					<figure class="corso__figura">
						<img
							src={corso.immagine}
							alt={`${corso.nome}`}
							loading="eager"
							fetchpriority="high"
							decoding="async"
							width="960"
							height="640"
						/>
						{suono && (
							<figcaption>
								<button
									type="button"
									class="corso__audio"
									data-audio={suono}
									aria-pressed="false"
								>
									<span class="corso__audio-icona" aria-hidden="true"></span>
									<span class="corso__audio-testo">Ascolta il suono</span>
								</button>
							</figcaption>
						)}
					</figure>
				)
			}

			<section class="corso__scheda" aria-labelledby="schedaTitolo">
				<h2 id="schedaTitolo">Informazioni pratiche</h2>

				{
					mancanti > 0 && (
						<p class="corso__avviso">
							{mancanti === totaleCampi
								? 'Le informazioni organizzative di questo corso non sono ancora state pubblicate.'
								: 'Alcune informazioni di questo corso non sono ancora state pubblicate.'}{' '}
							Scrivici e ti rispondiamo con i dettagli aggiornati.
						</p>
					)
				}

				<dl class="corso__lista">
					<div class="corso__riga">
						<dt>Quota</dt>
						<dd class:list={['tabular', { 'is-vuoto': !haPrezzi && !haQuota }]}>
							{
								haPrezzi && (
									<>
										<span class="corso__prezzo">
											{formattaPrezzo(rigaPredefinita.mese)}
											<span class="corso__prezzo-unita"> al mese</span>
										</span>
										<span class="corso__prezzo-dettaglio">
											{formattaPrezzo(rigaPredefinita.anno)} all’anno ({MESI_CORSO} mesi)
											&middot; lezione da {durataPredefinita.etichetta}
										</span>
										<button
											type="button"
											class="corso__scala-apri"
											aria-haspopup="dialog"
										>
											Scala prezzi
										</button>
									</>
								)
							}
							{
								haQuota && (
									<>
										<span class="corso__prezzo">
											{formattaPrezzo(alMese(corso.quotaAnnuale))}
											<span class="corso__prezzo-unita"> al mese</span>
										</span>
										<span class="corso__prezzo-dettaglio">
											{formattaPrezzo(corso.quotaAnnuale)} all’anno ({MESI_CORSO} mesi)
										</span>
										{corso.inclusoConStrumento && (
											<p class="corso__incluso">
												Questa quota vale per chi non frequenta ancora un corso di
												strumento. Da quando si inizia con uno strumento, il corso
												è compreso nella quota dello strumento stesso.
											</p>
										)}
									</>
								)
							}
							{!haPrezzi && !haQuota && '— da confermare'}
						</dd>
					</div>
					{
						scheda.map(riga => (
							<div class="corso__riga">
								<dt>{riga.voce}</dt>
								<dd class:list={['tabular', { 'is-vuoto': daConfermare(riga.valore) }]}>
									{riga.valore}
								</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section class="corso__azioni">
				<Button href="/company/contact">Chiedi informazioni</Button>
				<Button href="/scuola/corsi" outlined>Vedi gli altri corsi</Button>
			</section>
		</article>
	</Container>

	<!-- SCALA PREZZI -->
	{
		haPrezzi && (
			<div id="scalaModal" class="scala" hidden>
				<div class="scala__fondo" data-chiudi />
				<div
					class="scala__box"
					role="dialog"
					aria-modal="true"
					aria-labelledby="scalaTitolo"
					data-sconto-banda={SCONTO_BANDA_ANNUO}
					data-sconto-fratelli={SCONTO_FRATELLI_ANNUO}
					data-mesi={MESI}
				>
					<button type="button" class="scala__chiudi" data-chiudi aria-label="Chiudi">
						&times;
					</button>

					<h2 id="scalaTitolo" class="scala__titolo">Scala prezzi</h2>
					<p class="scala__sottotitolo">
						{corso.nome} &middot; quote su {MESI_CORSO} mesi di lezione.
					</p>

					<table class="scala__tabella">
						<thead>
							<tr>
								<th scope="col">Lezione settimanale</th>
								<th scope="col" class="scala__col-prezzo">Al mese</th>
								<th scope="col" class="scala__col-prezzo">All’anno</th>
							</tr>
						</thead>
						<tbody>
							{scala.map(riga => (
								<tr>
									<th scope="row">{riga.etichetta}</th>
									<td class="scala__col-prezzo tabular" data-base={riga.anno} data-tipo="mese">
										{formattaPrezzo(riga.mese)}
									</td>
									<td
										class="scala__col-prezzo scala__col-anno tabular"
										data-base={riga.anno}
										data-tipo="anno"
									>
										{formattaPrezzo(riga.anno)}
									</td>
								</tr>
							))}
						</tbody>
					</table>

					<fieldset class="scala__sconti">
						<legend class="scala__sconti-titolo">Riduzioni</legend>

						<div class="scala__sconto">
							<label class="interruttore" for="scontoBanda">
								<input
									type="checkbox"
									id="scontoBanda"
									class="interruttore__input"
									data-sconto="banda"
								/>
								<span class="interruttore__pista" aria-hidden="true">
									<span class="interruttore__pallino" />
								</span>
								<span class="interruttore__testo">Suono nella banda</span>
							</label>
							<p class="scala__sconto-nota">
								Chi suona attivamente in banda risparmia {euro(SCONTO_BANDA_ANNUO)}
								l’anno, cioè {euro(risparmioMese)} al mese.
							</p>
						</div>

						<div class="scala__sconto">
							<label class="interruttore" for="scontoFratelli">
								<input
									type="checkbox"
									id="scontoFratelli"
									class="interruttore__input"
									data-sconto="fratelli"
								/>
								<span class="interruttore__pista" aria-hidden="true">
									<span class="interruttore__pallino" />
								</span>
								<span class="interruttore__testo">Dal secondo figlio iscritto</span>
							</label>
							<p class="scala__sconto-nota">
								Dal secondo figlio iscritto la quota annuale scende di
								{euro(SCONTO_FRATELLI_ANNUO)}, cioè {euro(risparmioFratelliMese)} al
								mese. Si somma alla riduzione per chi suona in banda.
							</p>
						</div>
					</fieldset>

					<p class="scala__stato" role="status" aria-live="polite" hidden></p>
				</div>
			</div>
		)
	}

	<script>
		// ---- SCALA PREZZI ----
		const apri = document.querySelector('.corso__scala-apri');
		const modale = document.getElementById('scalaModal');

		if (apri && modale) {
			const box = modale.querySelector('.scala__box');
			const celle = [...modale.querySelectorAll('[data-base]')];
			const interruttori = [...modale.querySelectorAll('[data-sconto]')];
			const stato = modale.querySelector('.scala__stato');
			let ultimoFocus = null;

			// Le riduzioni sono importi fissi sulla quota ANNUALE e si sommano.
			// Il mensile si ricava dopo, altrimenti due sottrazioni arrotondate
			// separatamente non tornerebbero con l'annuale mostrato accanto.
			const SCONTI = {
				banda: Number(box.dataset.scontoBanda),
				fratelli: Number(box.dataset.scontoFratelli),
			};
			const MESI = Number(box.dataset.mesi);
			const ETICHETTE = {
				banda: 'chi suona in banda',
				fratelli: 'secondo figlio',
			};

			const intero = new Intl.NumberFormat('it-IT', {
				style: 'currency', currency: 'EUR',
				minimumFractionDigits: 0, maximumFractionDigits: 0,
			});
			const decimale = new Intl.NumberFormat('it-IT', {
				style: 'currency', currency: 'EUR',
				minimumFractionDigits: 2, maximumFractionDigits: 2,
			});
			const euro = n => (Number.isInteger(n) ? intero : decimale).format(n);
			const centesimi = n => Math.round(n * 100) / 100;

			function attivi() {
				return interruttori.filter(i => i.checked).map(i => i.dataset.sconto);
			}

			function aggiornaPrezzi() {
				const scelti = attivi();
				const totale = scelti.reduce((somma, k) => somma + SCONTI[k], 0);

				celle.forEach(cella => {
					const baseAnno = Number(cella.dataset.base);
					const annoScontato = Math.max(0, baseAnno - totale);
					const mese = cella.dataset.tipo === 'mese';
					const pieno = mese ? centesimi(baseAnno / MESI) : baseAnno;
					const nuovo = mese ? centesimi(annoScontato / MESI) : annoScontato;

					cella.classList.toggle('is-scontato', totale > 0);
					cella.replaceChildren();
					if (totale > 0) {
						// il pieno resta visibile barrato: senza confronto la
						// riduzione non si legge
						const barrato = document.createElement('s');
						barrato.className = 'scala__pieno';
						barrato.textContent = euro(pieno);
						const finale = document.createElement('span');
						finale.className = 'scala__nuovo';
						finale.textContent = euro(nuovo);
						cella.append(barrato, ' ', finale);
					} else {
						cella.textContent = euro(pieno);
					}
				});

				if (totale === 0) {
					stato.hidden = true;
					stato.textContent = '';
					return;
				}
				const quali = scelti.map(k => ETICHETTE[k]).join(' e ');
				stato.hidden = false;
				stato.textContent =
					`Riduzione di ${euro(totale)} l'anno (${euro(centesimi(totale / MESI))} al mese) — ${quali}.`;
			}

			interruttori.forEach(i => i.addEventListener('change', aggiornaPrezzi));

			function chiudi() {
				modale.hidden = true;
				document.body.style.overflow = '';
				if (ultimoFocus) ultimoFocus.focus();
			}

			apri.addEventListener('click', () => {
				ultimoFocus = apri;
				modale.hidden = false;
				document.body.style.overflow = 'hidden';
				interruttori[0].focus();
			});

			modale.querySelectorAll('[data-chiudi]').forEach(el =>
				el.addEventListener('click', chiudi)
			);

			document.addEventListener('keydown', e => {
				if (modale.hidden) return;
				if (e.key === 'Escape') {
					chiudi();
					return;
				}
				// il focus resta dentro la finestra finché è aperta
				if (e.key === 'Tab') {
					const f = [...box.querySelectorAll('button, input')].filter(
						el => !el.disabled && el.offsetParent !== null
					);
					if (!f.length) return;
					const primo = f[0];
					const ultimo = f[f.length - 1];
					if (e.shiftKey && document.activeElement === primo) {
						e.preventDefault();
						ultimo.focus();
					} else if (!e.shiftKey && document.activeElement === ultimo) {
						e.preventDefault();
						primo.focus();
					}
				}
			});
		}

		// Un solo elemento audio per pagina; il pulsante è un vero toggle
		// (WCAG 1.4.2: l'audio non parte mai da solo e si può sempre fermare).
		const bottone = document.querySelector('.corso__audio');

		if (bottone) {
			const audio = new Audio();
			const testo = bottone.querySelector('.corso__audio-testo');
			const etichettaIniziale = testo.textContent;

			audio.preload = 'auto';

			const ferma = () => {
				audio.pause();
				bottone.setAttribute('aria-pressed', 'false');
				testo.textContent = etichettaIniziale;
			};

			const fallito = () => {
				bottone.setAttribute('aria-pressed', 'false');
				testo.textContent = 'Audio non disponibile';
				// l'etichetta torna com'era: il pulsante resta riprovabile
				setTimeout(() => {
					if (bottone.getAttribute('aria-pressed') === 'false') {
						testo.textContent = etichettaIniziale;
					}
				}, 2500);
			};

			bottone.addEventListener('click', () => {
				if (bottone.getAttribute('aria-pressed') === 'true') {
					ferma();
					return;
				}
				if (audio.src !== new URL(bottone.dataset.audio, location.href).href) {
					audio.src = bottone.dataset.audio;
				}
				audio.currentTime = 0;
				audio.play().then(() => {
					bottone.setAttribute('aria-pressed', 'true');
					testo.textContent = 'Ferma l’ascolto';
				}, fallito);
			});

			audio.addEventListener('ended', ferma);
			audio.addEventListener('error', fallito);
		}
	</script>
</Layout>

<style>
	.corso {
		margin: var(--space-lg) auto var(--section-margin);
		max-width: 54rem;
	}

	.corso__back {
		margin-bottom: var(--space-lg);
	}
	.corso__back a {
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
		text-decoration: none;
		transition: color var(--theme-transition);
	}
	.corso__back a:hover {
		color: var(--theme-on-bg);
	}

	.corso__header h1 {
		margin-bottom: var(--space-3xs);
	}

	.corso__famiglia {
		margin: 0 0 var(--space-md);
		max-width: none;
		font-size: var(--font-size-sm);
		color: var(--theme-accent);
	}

	.corso__descrizione {
		font-size: var(--font-size-md);
		line-height: 1.45;
		color: var(--theme-on-bg);
	}

	.corso__figura {
		margin: var(--space-xl) 0;
	}
	.corso__figura img {
		width: 100%;
		height: auto;
		max-height: 26rem;
		object-fit: cover;
		border-radius: var(--radius-lg);
		box-shadow: var(--theme-elevation-2);
	}
	.corso__figura figcaption {
		margin-top: var(--space-sm);
	}

	.corso__audio {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem var(--space-sm) 0.55rem var(--space-xs);
		background-color: transparent;
		border: 1px solid var(--theme-border-strong);
		border-radius: var(--radius-sm);
		color: var(--theme-on-bg);
		font-size: var(--font-size-sm);
		font-weight: 500;
		cursor: pointer;
		transition: background-color var(--theme-transition),
			border-color var(--theme-transition);
	}
	.corso__audio:hover {
		background-color: var(--theme-surface-1);
		border-color: var(--theme-primary);
	}
	.corso__audio:active {
		background-color: var(--theme-surface-2);
	}

	/* Triangolo play → doppia barra pause, senza libreria di icone */
	.corso__audio-icona {
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0.4rem 0 0.4rem 0.65rem;
		border-color: transparent transparent transparent var(--theme-primary);
	}
	.corso__audio[aria-pressed='true'] .corso__audio-icona {
		width: 0.62rem;
		height: 0.8rem;
		border: 0;
		background: linear-gradient(
			to right,
			var(--theme-primary) 0 34%,
			transparent 34% 66%,
			var(--theme-primary) 66% 100%
		);
	}

	.corso__scheda {
		margin: var(--space-xl) 0;
	}
	.corso__scheda h2 {
		font-size: var(--font-size-md);
		margin-bottom: var(--space-sm);
	}

	.corso__avviso {
		max-width: none;
		margin-bottom: var(--space-md);
		padding: var(--space-xs) var(--space-sm);
		border-left: 3px solid var(--theme-accent);
		background-color: var(--theme-surface-1);
		border-radius: var(--radius-sm);
		font-size: var(--font-size-sm);
		color: var(--theme-on-surface-1);
	}

	/* Scheda tecnica: righe con filetto, non card dentro card */
	.corso__lista {
		margin: 0;
		border-top: 1px solid var(--theme-border);
	}
	.corso__riga {
		display: grid;
		grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
		gap: var(--space-sm);
		padding: var(--space-sm) 0;
		border-bottom: 1px solid var(--theme-border);
	}
	.corso__riga dt {
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--theme-muted);
	}
	.corso__riga dd {
		margin: 0;
		font-variant-numeric: tabular-nums;
	}
	.corso__riga dd.is-vuoto {
		color: var(--theme-muted);
		font-style: italic;
	}

	.corso__azioni {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
	}

	@media (max-width: 640px) {
		.corso__riga {
			grid-template-columns: 1fr;
			gap: var(--space-3xs);
		}
	}
	/* ---- RIGA PREZZO ---- */
	.corso__prezzo {
		display: block;
		font-family: var(--theme-font-family-serif);
		font-size: var(--font-size-md);
		font-weight: 600;
		line-height: 1.15;
	}
	.corso__prezzo-dettaglio {
		display: block;
		font-size: var(--font-size-xs);
		color: var(--theme-muted);
		margin-top: 0.1rem;
	}
	.corso__scala-apri {
		margin-top: var(--space-2xs);
		padding: 0.35rem var(--space-xs);
		background: transparent;
		border: 1px solid var(--theme-border-strong);
		border-radius: var(--radius-sm);
		color: var(--theme-on-bg);
		font-family: var(--theme-font-family-sans);
		font-size: var(--font-size-xs);
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color var(--theme-transition),
			border-color var(--theme-transition);
	}
	.corso__scala-apri:hover:not(:disabled) {
		background-color: var(--theme-surface-1);
		border-color: var(--theme-primary);
	}
	.corso__scala-apri:active:not(:disabled) {
		background-color: var(--theme-surface-2);
	}
	.corso__scala-apri:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	/* ---- MODAL SCALA PREZZI ---- */
	.scala {
		position: fixed;
		inset: 0;
		z-index: var(--z-modal);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-sm);
	}
	.scala[hidden] {
		display: none;
	}
	.scala__fondo {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--ink) 58%, transparent);
	}
	.scala__box {
		position: relative;
		z-index: 1;
		width: min(94vw, 30rem);
		max-height: 88dvh;
		overflow-y: auto;
		padding: var(--space-lg) var(--space-md) var(--space-md);
		background: var(--theme-bg);
		border-radius: var(--radius-lg);
		box-shadow: var(--theme-elevation-3);
	}
