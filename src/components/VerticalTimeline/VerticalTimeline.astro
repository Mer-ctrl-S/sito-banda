---
// VerticalTimeline.astro

interface TimelineItem {
  date: string;
  title?: string;
  content?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  items: TimelineItem[];
  className?: string;
}

const { items, className = '' } = Astro.props;
---

<ol class={`timeline ${className}`}>
  {items.map((item) => (
    <li class="timeline-item">

      <!-- linea -->
      <div class="timeline-line"></div>

      <!-- header timeline -->
      <div class="timeline-header">

        <!-- puntino -->
        <div class="timeline-dot"></div>

        <!-- data -->
        <div class="timeline-date">
          {item.date}
        </div>

      </div>

      <!-- contenuto -->
      <article class="timeline-card">

        {item.title && (
          <h3 class="timeline-title">
            {item.title}
          </h3>
        )}

        {item.content && (
          <div class="timeline-text">
            {item.content}
          </div>
        )}

        {item.image && (
          <div class="timeline-image-wrapper">
            <img
              src={item.image}
              alt={item.imageAlt ?? item.title ?? 'Timeline image'}
              class="timeline-image"
              loading="lazy"
            />
          </div>
        )}

      </article>

    </li>
  ))}
</ol>

<style>

:root {
  --timeline-green: #395a3b;
  --timeline-green-light: #c3d9c4;

  --timeline-bg: #e6e4e0;
  --timeline-text: #2c3e2d;

  --timeline-line-width: 4px;
  --timeline-dot-size: 22px;

  --timeline-axis-width: 40px;
}

/* TIMELINE */

.timeline {
  position: relative;

  list-style: none;

  margin: 0;
  padding: 0;
}

/* ITEM */

.timeline-item {
  position: relative;

  padding-bottom: 3rem;
}

/* LINEA */

.timeline-line {
  position: absolute;

  left: calc(
    (var(--timeline-axis-width) / 2) -
    (var(--timeline-line-width) / 2)
  );

  top: 0;
  bottom: 0;

  width: var(--timeline-line-width);

  background: var(--timeline-green);

  border-radius: 999px;
}

/* ultimo item */

.timeline-item:last-child .timeline-line {
  bottom: calc(100% - 34px);
}

/* HEADER */

.timeline-header {
  position: relative;

  display: grid;
  grid-template-columns: var(--timeline-axis-width) auto;

  align-items: center;

  margin-bottom: 1rem;

  z-index: 2;
}

/* DOT */

.timeline-dot {
  width: var(--timeline-dot-size);
  height: var(--timeline-dot-size);

  margin: 0 auto;

  border-radius: 999px;

  background: var(--timeline-green);

  border: 4px solid white;

  box-shadow:
    0 0 0 4px var(--timeline-green-light);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.timeline-item:hover .timeline-dot {
  transform: scale(1.1);
}

/* DATE */

.timeline-date {
  justify-self: start;

  display: inline-flex;
  align-items: center;

  padding: 0.45rem 0.85rem;

  border-radius: 999px;

  background: var(--timeline-green-light);

  color: var(--timeline-text);

  font-size: 0.82rem;
  font-weight: 700;

  white-space: nowrap;
}

/* CARD */

.timeline-card {
  margin-left: calc(
    var(--timeline-axis-width) + 1rem
  );

  background: var(--timeline-bg);

  border-radius: 1.25rem;

  padding: 1.5rem;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.timeline-card:hover {
  transform: translateY(-2px);

  box-shadow:
    0 10px 30px rgba(0,0,0,0.08);
}

/* TYPOGRAPHY */

.timeline-title {
  margin: 0 0 0.75rem;

  color: var(--timeline-text);

  font-size: 1.15rem;
  font-weight: 700;
}

.timeline-text {
  color: #444;

  line-height: 1.7;
}

/* IMAGE */

.timeline-image-wrapper {
  margin-top: 1rem;
}

.timeline-image {
  display: block;

  width: 100%;
  height: auto;

  aspect-ratio: 16 / 9;

  object-fit: cover;

  border-radius: 1rem;
}

/* MOBILE */

@media (max-width: 768px) {

  :root {
    --timeline-axis-width: 34px;
    --timeline-dot-size: 18px;
  }

  .timeline-item {
    padding-bottom: 2.5rem;
  }

  .timeline-date {
    font-size: 0.75rem;

    white-space: normal;
  }

  .timeline-card {
    margin-left: calc(
      var(--timeline-axis-width) + 0.75rem
    );

    padding: 1.1rem;
  }

  .timeline-title {
    font-size: 1rem;
  }

}

</style>
