---
// VerticalTimeline.astro

interface TimelineItem {
  date: string;
  title?: string;
  content?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  items: TimelineItem[];
  className?: string;
}

const { items, className = '' } = Astro.props;
---

<ol class={`timeline ${className}`}>
  {items.map((item) => (
    <li class="timeline-item">

      <!-- linea -->
      <div class="timeline-line"></div>

      <!-- header timeline -->
      <div class="timeline-header">

        <!-- puntino -->
        <div class="timeline-dot"></div>

        <!-- data -->
        <div class="timeline-date">
          {item.date}
        </div>

      </div>

      <!-- contenuto -->
      <article class="timeline-card">

        {/* h2 e non h3: sotto l'h1 della pagina saltare un livello spezza la
            navigazione per intestazioni dei lettori di schermo. La dimensione
            la dà la classe, non l'elemento. */}
        {item.title && (
          <h2 class="timeline-title">
            {item.title}
          </h2>
        )}

        {item.content && (
          <div class="timeline-text">
            {item.content}
          </div>
        )}

        {item.image && (
          <div class="timeline-image-wrapper">
            <img
              src={item.image}
              alt={item.imageAlt ?? item.title ?? 'Timeline image'}
              class="timeline-image"
              loading="lazy"
            />
          </div>
        )}

      </article>

    </li>
  ))}
</ol>

<style>

:root {
  /* Erano quattro colori scritti a mano che ripetevano la palette:
     #395a3b, #c3d9c4, #e6e4e0, #2c3e2d. Ora la seguono. */
  --timeline-green: var(--theme-primary-hover);
  --timeline-green-light: var(--theme-surface-2);

  --timeline-bg: var(--theme-surface-1);
  --timeline-text: var(--theme-on-surface-1);

  --timeline-line-width: 4px;
  --timeline-dot-size: 22px;

  --timeline-axis-width: 40px;
}

/* TIMELINE */

.timeline {
  position: relative;

  list-style: none;

  margin: 0;
  padding: 0;
}

/* ITEM */

.timeline-item {
  position: relative;

  padding-bottom: 3rem;
}

/* LINEA */

.timeline-line {
  position: absolute;

  left: calc(
    (var(--timeline-axis-width) / 2) -
    (var(--timeline-line-width) / 2)
  );

  top: 0;
  bottom: 0;

  width: var(--timeline-line-width);

  background: var(--timeline-green);

  border-radius: 999px;
}

/* ultimo item */

.timeline-item:last-child .timeline-line {
  bottom: calc(100% - 34px);
}

/* HEADER */

.timeline-header {
  position: relative;

  display: grid;
  grid-template-columns: var(--timeline-axis-width) auto;

  align-items: center;

  margin-bottom: 1rem;

  z-index: 2;
}

/* DOT */

.timeline-dot {
  width: var(--timeline-dot-size);
  height: var(--timeline-dot-size);

  margin: 0 auto;

  border-radius: 999px;

  background: var(--timeline-green);

  border: 4px solid var(--theme-bg);

  box-shadow:
    0 0 0 4px var(--timeline-green-light);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.timeline-item:hover .timeline-dot {
  transform: scale(1.1);
}

/* DATE */

.timeline-date {
  justify-self: start;

  display: inline-flex;
  align-items: center;

  padding: var(--space-2xs) var(--space-xs);

  border-radius: 999px;

  background: var(--timeline-green-light);

  color: var(--timeline-text);

  font-size: 0.82rem;
  font-weight: 700;

  white-space: nowrap;
}

/* CARD */

.timeline-card {
  margin-left: calc(
    var(--timeline-axis-width) + 1rem
  );

  background: var(--timeline-bg);

  border-radius: 1.25rem;

  padding: var(--blocco-padding);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.timeline-card:hover {
  transform: translateY(-2px);

  box-shadow: var(--theme-elevation-2);
}

/* TYPOGRAPHY */

.timeline-title {
  margin: 0 0 var(--space-xs);

  color: var(--timeline-text);

  font-size: 1.15rem;
  font-weight: 700;
}

.timeline-text {
  color: var(--theme-muted);

  line-height: 1.7;
}

/* IMAGE */

.timeline-image-wrapper {
  margin-top: 1rem;
}

.timeline-image {
  display: block;

  width: 100%;
  height: auto;

  aspect-ratio: 16 / 9;

  object-fit: cover;

  border-radius: 1rem;
}

/* MOBILE */

@media (max-width: 768px) {

  :root {
    --timeline-axis-width: 34px;
    --timeline-dot-size: 18px;
  }

  .timeline-item {
    padding-bottom: 2.5rem;
  }

  .timeline-date {
    font-size: 0.75rem;

    white-space: normal;
  }

  .timeline-card {
    margin-left: calc(
      var(--timeline-axis-width) + 0.75rem
    );

    padding: var(--space-sm);
  }

  .timeline-title {
    font-size: 1rem;
  }

}

</style>
