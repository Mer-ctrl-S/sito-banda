---
const {
	label,
	name,
	options,
	required,
	placeholder = 'Scegli un’opzione',
} = Astro.props;

const id = `field-${name}`;
const errorId = `${id}-error`;
---

<div class="form-field__container">
	{
		label && (
			<label for={id}>
				{label}
				{required && <span class="form-field__required" aria-hidden="true">*</span>}
			</label>
		)
	}
	<div class="form-field__select-wrap">
		<select id={id} name={name} required={required} aria-describedby={errorId}>
			<option disabled selected value="">{placeholder}</option>
			{options?.map((option) => <option value={option}>{option}</option>)}
		</select>
		<svg class="form-field__chevron" viewBox="0 0 20 20" aria-hidden="true">
			<path
				d="M5.5 8L10 12.5L14.5 8"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</div>
	<p class="form-field__error" id={errorId} aria-live="polite"></p>
</div>

<style>
	.form-field__container label {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 500;
		margin-bottom: var(--space-3xs);
	}
	.form-field__required {
		color: var(--theme-accent);
		margin-left: 0.15em;
	}
	.form-field__select-wrap {
		position: relative;
		display: block;
	}
	.form-field__container select {
		width: 100%;
		padding: 0.7rem 2.5rem 0.7rem 0.85rem;
		background-color: var(--theme-bg);
		border: 1px solid var(--theme-border-strong);
		color: var(--theme-on-bg);
		border-radius: var(--radius-sm);
		font-size: inherit;
		font-family: inherit;
		/* Toglie l'effetto lucido dei select su Safari */
		-webkit-appearance: none;
		appearance: none;
		transition: border-color var(--theme-transition),
			box-shadow var(--theme-transition);
	}
	.form-field__container select:focus {
		outline: none;
		border-color: var(--theme-primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--theme-primary) 18%, transparent);
	}
	.form-field__container select[aria-invalid='true'] {
		border-color: #a8412f;
		box-shadow: 0 0 0 3px rgba(168, 65, 47, 0.14);
	}
	.form-field__chevron {
		position: absolute;
		right: 0.85rem;
		top: 50%;
		transform: translateY(-50%);
		width: 1.15rem;
		height: 1.15rem;
		pointer-events: none;
		color: var(--theme-muted);
	}
	.form-field__error {
		margin: 0;
		max-width: none;
		min-height: 1.2em;
		font-size: var(--font-size-xs);
		color: #8f3527;
	}
</style>
