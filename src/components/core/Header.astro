---
import { Icon } from 'astro-icon/components';
const { navData, rightMenu } = Astro.props;

// Indicatore di pagina corrente: senza, l'utente non sa dove si trova.
const strip = (p) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const current = strip(Astro.url.pathname);
const isCurrent = (slug) => {
	const s = strip(slug);
	return s === '/' ? current === '/' : current === s || current.startsWith(s + '/');
};
---

<script type="module">
	const bodyElement = document.querySelector('body');
	const menuButton = document.querySelector('#menuButton');
	const navHeader = document.querySelector('#odysseyNavHeader');
	const menuButtonIconHam = document.querySelector('#menuButtonIconHam');
	const menuButtonIconClose = document.querySelector('#menuButtonIconClose');
	let scrollPosition = 0;

	menuButton.addEventListener('click', toggleMenu);

	function toggleMenu() {
		menuButtonIconHam.toggleAttribute('hidden');
		menuButtonIconClose.toggleAttribute('hidden');

		const isOpen = navHeader.hasAttribute('mobile-menu-open');

		if (isOpen) {
			menuButton.title = 'Apri il menu principale';
			menuButton.setAttribute('aria-expanded', 'false');
			bodyElement.style.removeProperty('overflow');
			bodyElement.style.removeProperty('position');
			bodyElement.style.removeProperty('top');
			bodyElement.style.removeProperty('width');
			window.scrollTo(0, scrollPosition);
		} else {
			menuButton.title = 'Chiudi il menu principale';
			menuButton.setAttribute('aria-expanded', 'true');
			scrollPosition = window.pageYOffset;
			bodyElement.style.overflow = 'hidden';
			bodyElement.style.position = 'fixed';
			bodyElement.style.top = `-${scrollPosition}px`;
			bodyElement.style.width = '100%';
		}

		navHeader.toggleAttribute('mobile-menu-open');
	}

	// Ombra dell’header solo quando la pagina e' effettivamente scrollata
	const onScroll = () => {
		navHeader.toggleAttribute('scrolled', window.scrollY > 8);
	};
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });
</script>

<header id="odysseyNavHeader" class={rightMenu ? 'header--right' : undefined}>
	<div class="header-logo-menu__container">
		<button
			id="menuButton"
			type="button"
			title="Apri il menu principale"
			aria-label="Apri il menu principale"
			aria-expanded="false"
			aria-controls="mainNav"
		>
			<span id="menuButtonIconHam">
				<Icon name="ic:baseline-menu" width="24px" height="24px" />
			</span>
			<span id="menuButtonIconClose" hidden>
				<Icon name="ic:baseline-close" width="24px" height="24px" />
			</span>
		</button>
		<a class="header-logo__link" href="/">
			<slot name="logo" />
		</a>
	</div>
	<div class="header-nav__container" id="mainNav">
		<slot name="nav">
			{
				navData && (
					<nav aria-label="Menu principale">
						<ul>
							{navData.map((navItem) => (
								<li>
									<a
										href={navItem.slug}
										aria-current={isCurrent(navItem.slug) ? 'page' : undefined}
									>
										{navItem.icona && (
											<Icon
												class="nav-icona"
												name={navItem.icona}
												width="22"
												height="22"
												aria-hidden="true"
											/>
										)}
										<span>{navItem.title}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</slot>
	</div>
	<div class="header-action-item__container">
		<slot name="action-item" />
	</div>
</header>

<style>
	header {
		width: 100%;
		min-height: var(--navbar-height);
		padding: var(--space-sm) clamp(1.25rem, 5vw, 3rem);
		display: flex;
		justify-content: space-between;
		align-items: center;
		position: sticky;
		top: 0;
		z-index: var(--z-sticky);
		background-color: color-mix(in srgb, var(--theme-bg) 82%, transparent);
		backdrop-filter: saturate(140%) blur(14px);
		-webkit-backdrop-filter: saturate(140%) blur(14px);
		border-bottom: 1px solid transparent;
		transition: border-color var(--theme-transition),
			background-color var(--theme-transition);
	}
	header[scrolled] {
		border-bottom-color: var(--theme-border);
		background-color: color-mix(in srgb, var(--theme-bg) 92%, transparent);
	}
	/*
	  Con il menu aperto niente backdrop-filter: un filtro sull'antenato rende
	  l'header il containing block dei figli position: fixed, e l'overlay a tutto
	  schermo si riduce alla barra. Spento qui, torna a coprire lo schermo.
	*/
	header[mobile-menu-open] {
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		background-color: transparent;
		border-bottom-color: transparent;
	}
	header.header--right {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--space-md);
		align-items: center;
	}
	.header-nav__container {
		justify-self: end;
	}
	.header-logo__link {
		width: fit-content;
		color: inherit;
		text-decoration: none;
		display: flex;
		align-items: center;
	}
	.header-logo-menu__container {
		display: flex;
		align-items: center;
		z-index: var(--z-sticky);
	}
	.header-action-item__container {
		z-index: var(--z-sticky);
	}
	#menuButton {
		border: none;
		background-color: transparent;
		margin-right: var(--space-2xs);
		display: none;
		cursor: pointer;
		padding: 0.35rem;
		border-radius: var(--radius-sm);
		-webkit-tap-highlight-color: transparent;
	}
	#menuButton > span {
		color: var(--theme-on-bg);
		vertical-align: middle;
		display: block;
	}
	nav {
		display: flex;
	}
	nav ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		gap: clamp(0.75rem, 1.8vw, 1.75rem);
	}
	nav ul li {
		max-width: none;
	}
	/* Nella barra del desktop le icone sarebbero rumore: compaiono solo nel
	   menu a tutto schermo del telefono. */
	.nav-icona {
		display: none;
	}

	nav ul li a {
		position: relative;
		display: block;
		padding: 0.35rem 0;
		text-decoration: none;
		color: inherit;
		font-size: var(--font-size-sm);
		font-weight: 500;
		opacity: 0.68;
		transition: opacity var(--theme-transition);
	}
	nav ul li a:hover {
		opacity: 1;
	}
	/* Filetto in ottone: unico segnale di pagina corrente */
	nav ul li a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 2px;
		background-color: var(--theme-accent);
		border-radius: 2px;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 320ms var(--ease-out);
	}
	nav ul li a[aria-current='page'] {
		opacity: 1;
		font-weight: 600;
	}
	nav ul li a[aria-current='page']::after {
		transform: scaleX(1);
	}

	@media (max-width: 600px) {
		/* Sul telefono la colonna centrale della griglia (la nav) e' un overlay
		   position: fixed: lasciata nella griglia sprecava due gap e spingeva il
		   nome del sito sotto il pulsante "Area soci". Qui torno a un flex a due
		   voci e lascio che il logo si stringa. */
		header.header--right {
			display: flex;
			gap: var(--space-xs);
		}
		.header-logo-menu__container {
			min-width: 0;
			flex: 1 1 auto;
		}
		.header-logo__link {
			width: auto;
			min-width: 0;
			overflow: hidden;
		}
		.header-action-item__container {
			flex: none;
		}
		#menuButton {
			display: block;
			z-index: var(--z-sticky);
		}
		.header-nav__container {
			width: 100%;
			height: 100dvh;
			background-color: var(--theme-bg);
			display: none;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			position: fixed;
			inset: 0;
			z-index: calc(var(--z-sticky) - 1);
		}
		header[mobile-menu-open] .header-nav__container {
			display: flex;
		}
		/* stretch, non center: cosi' le voci sono larghe uguali e le icone
		   formano una colonna invece di sfalsarsi seguendo il testo. */
		header[mobile-menu-open] nav ul {
			align-items: stretch;
			flex-direction: column;
			gap: var(--space-md);
		}
		header[mobile-menu-open] nav ul li a {
			display: flex;
			align-items: center;
			gap: var(--space-sm);
			font-family: var(--theme-font-family-serif);
			font-size: var(--font-size-lg);
			font-weight: 600;
		}
		header[mobile-menu-open] .nav-icona {
			display: block;
			flex: none;
			color: var(--theme-accent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		nav ul li a::after {
			transition: none;
		}
	}
</style>
