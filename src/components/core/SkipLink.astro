<a class="skip-link" href="#content">Vai al contenuto principale</a>

<style>
	/*
	  Usava --color-white e --font-display, due variabili mai definite nel tema:
	  il link di salto, cioè un requisito di accessibilita', era senza stile.
	*/
	.skip-link {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--theme-font-family-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		text-decoration: none;
		background-color: var(--theme-primary);
		color: var(--theme-on-primary);
		z-index: var(--z-modal);

		/* Nascosto visivamente, ma raggiungibile da tastiera */
		clip-path: inset(50%);
		height: 1px;
		width: 1px;
		overflow: hidden;
		white-space: nowrap;
	}

	.skip-link:focus {
		position: fixed;
		inset: 0 0 auto 0;
		width: 100%;
		height: 3rem;
		clip-path: none;
		overflow: visible;
		outline: 2px solid var(--theme-accent);
		outline-offset: -4px;
	}
</style>
