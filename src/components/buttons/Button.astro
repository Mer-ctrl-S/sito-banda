---
const { href, unelevated, outlined, customIcon, onPrimary, newTab, class: className } =
	Astro.props;

const Tag = href ? 'a' : 'button';

// Le classi venivano composte con `cond && 'x'`, che stampa "undefined"/"false"
// nell'attributo quando la prop non c'e'. Filtriamo prima di unire.
const classes = [
	'btn',
	unelevated && 'btn--unelevated',
	outlined && 'btn--outlined',
	onPrimary && 'btn--on-primary',
	className,
]
	.filter(Boolean)
	.join(' ');
---

<Tag
	class={classes}
	href={href}
	target={newTab ? '_blank' : undefined}
	rel={newTab ? 'noopener noreferrer' : undefined}
>
	<span class="btn__label"><slot /></span>
	{
		customIcon && (
			<span class="custom-icon__span" aria-hidden="true">
				<slot name="icon" />
			</span>
		)
	}
</Tag>

<style>
	.btn {
		--btn-bg: var(--theme-primary);
		--btn-fg: var(--theme-on-primary);
		--btn-shadow: 0 1px 2px rgba(26, 30, 25, 0.12);

		width: fit-content;
		padding: 0.7rem 1.35rem;
		margin-bottom: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		background-color: var(--btn-bg);
		color: var(--btn-fg);
		border: 2px solid transparent;
		border-radius: var(--theme-button-border-radius);
		font-family: var(--theme-font-family-sans);
		font-size: var(--font-size-sm);
		font-weight: 500;
		letter-spacing: 0.005em;
		line-height: 1.2;
		text-align: center;
		/* un'etichetta cliccabile non va mai su due righe */
		white-space: nowrap;
		box-shadow: var(--btn-shadow);
		/* transform e opacity: animazione accelerata dalla GPU */
		transition: background-color var(--theme-transition),
			color var(--theme-transition), border-color var(--theme-transition),
			transform 140ms var(--ease-spring), box-shadow var(--theme-transition);
	}

	.btn:hover {
		--btn-bg: var(--theme-primary-hover);
		--btn-shadow: 0 2px 4px rgba(26, 30, 25, 0.1),
			0 8px 18px rgba(26, 30, 25, 0.12);
		transform: translateY(-1px);
	}

	/* Ritorno fisico alla pressione */
	.btn:active {
		transform: translateY(0) scale(0.985);
		--btn-shadow: 0 1px 1px rgba(26, 30, 25, 0.14);
		transition-duration: 60ms;
	}

	.btn--unelevated {
		--btn-bg: transparent;
		--btn-fg: var(--theme-on-bg);
		--btn-shadow: none;
		padding-left: 0.5rem;
		padding-right: 0.5rem;
	}
	.btn--unelevated:hover {
		--btn-bg: color-mix(in srgb, var(--theme-on-bg) 7%, transparent);
		--btn-shadow: none;
	}

	.btn--outlined {
		--btn-bg: transparent;
		--btn-fg: var(--theme-primary);
		--btn-shadow: none;
		border-color: var(--theme-border-strong);
	}
	.btn--outlined:hover {
		--btn-bg: var(--theme-primary);
		--btn-fg: var(--theme-on-primary);
		border-color: var(--theme-primary);
	}

	.btn--on-primary {
		--btn-bg: var(--theme-on-primary);
		--btn-fg: var(--theme-primary);
	}
	.btn--on-primary:hover {
		--btn-bg: color-mix(in srgb, var(--theme-on-primary) 88%, var(--theme-primary));
	}

	.custom-icon__span {
		display: flex;
		align-items: center;
		/* Correzione ottica: l'icona sembra alta di un pelo rispetto alla riga */
		transform: translateY(0.5px);
		transition: transform 260ms var(--ease-spring);
	}
	.btn:hover .custom-icon__span {
		transform: translate(2px, 0.5px);
	}
	.custom-icon__span :global(svg) {
		width: 1.15em;
		height: 1.15em;
	}

	a.btn {
		text-decoration: none;
	}
	button.btn {
		cursor: pointer;
	}

	@media (prefers-reduced-motion: reduce) {
		.btn,
		.btn:hover,
		.btn:active,
		.btn:hover .custom-icon__span {
			transform: none;
		}
	}
</style>
