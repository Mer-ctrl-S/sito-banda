---
import { Container } from '@components/odyssey-theme';
---

<Container>
	<section class="hero-section__section">
		<div class="hero-section__text">
			<slot name="text-container"></slot>
		</div>
		<div class="hero-section__image">
			<slot name="image-container">
			</slot>
		</div>
	</section>
</Container>

<style>
	/*
	  Allineata a TextAndImageHero: era rimasta indietro con i valori vecchi
	  (78dvh e margine da sezione anche sopra), e su /blog produceva un hero
	  alto quasi 600px con dentro solo un titolo e una riga di testo.
	*/
	.hero-section__section {
		/* Margine ottico: poco sopra, l'header fa già da respiro */
		margin: var(--space-md) auto var(--section-margin);
		/*
		  Niente altezza minima: le due pagine che usano questo hero hanno un
		  titolo e due righe, e imporre 56dvh lasciava mezzo schermo vuoto
		  attorno al testo. L'altezza la detta l'immagine, con un tetto.
		*/
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
	}
	.hero-section__text {
		justify-self: start;
		max-width: 32rem;
	}
	.hero-btns__container {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}
	.hero-section__image {
		display: flex;
		/* Se l'immagine non carica la colonna non resta un buco bianco */
		min-height: 12rem;
		background: var(--theme-surface-1);
		border-radius: var(--radius-lg);
		box-shadow: var(--theme-elevation-2);
		overflow: hidden;
	}
	/* Raggio, ombra e ritaglio stanno sul contenitore: sull'immagine
	   raddoppierebbero il bordo arrotondato quando il file non carica. */
	.hero-section__image :global(img) {
		width: 100%;
		height: 100%;
		max-height: 30rem;
		object-fit: cover;
	}
	@media (max-width: 768px) {
		.hero-section__section {
			margin: var(--space-sm) auto var(--space-xl);
			min-height: 0;
			grid-template-columns: 1fr;
		}
		.hero-section__text {
			max-width: none;
		}
	}
</style>
