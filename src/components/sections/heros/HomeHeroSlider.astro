---
import { Icon } from 'astro-icon/components';
import { Container, Button } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import { ThemeSwitcher } from '../../theme-switcher/theme-switcher';

interface HeroImage {
  src: string;
  alt?: string;
}

interface Props {
  images?: HeroImage[];
  interval?: number;
}

const {
  images = [
    {
      src: '/assets/images/home/classic-hero.jpg',
      alt: 'Astro Odyssey'
    }
  ],
  interval = 5000
} = Astro.props;
---

<Container>
  <section class="hero-section__section">

    <!-- TEXT -->

    <div class="hero-section__text">

      <h1>Benvenuto</h1>

      <div class="hero-btns__container">

        <Button href="/theme/get-started" customIcon>
            Corsi

          <Fragment slot="icon">
            <Icon name="ic:baseline-chevron-right" />
          </Fragment>

        </Button>

        <Button href="/theme/style-guide" unelevated>
          Style Guide
        </Button>

      </div>

      {settings.enableThemeSwitcher && (
        <ThemeSwitcher client:only />
      )}

    </div>

    <!-- IMAGE SLIDER -->

    <div
      class="hero-section__image"
      data-hero-slider
      data-interval={interval}
    >

      {images.map((image, index) => (
        <picture
          class={`hero-slide ${index === 0 ? 'is-active' : ''}`}
        >
          <img
            src={image.src}
            alt={image.alt ?? 'Hero image'}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </picture>
      ))}

    </div>

  </section>
</Container>

<script>

  const sliders = document.querySelectorAll('[data-hero-slider]');

  sliders.forEach((slider) => {

    const slides = slider.querySelectorAll('.hero-slide');

    if (slides.length <= 1) return;

    const interval =
      Number(slider.getAttribute('data-interval')) || 5000;

    let currentIndex = 0;

    setInterval(() => {

      slides[currentIndex].classList.remove('is-active');

      currentIndex =
        (currentIndex + 1) % slides.length;

      slides[currentIndex].classList.add('is-active');

    }, interval);

  });

</script>

<style>

  .hero-section__section {
    margin: var(--section-margin) auto;

    min-height:
      clamp(
        90vh,
        100vw,
        calc(100vh - var(--navbar-height))
      );

    display: grid;

    grid-template-columns: 1fr 1fr;

    align-items: center;

    gap: 2rem;
  }

  /* TEXT */

  .hero-section__text {
    justify-self: center;

    max-width: 30rem;
  }

  .hero-btns__container {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 1rem;

    margin-top: 1.5rem;
  }

  /* IMAGE AREA */

  .hero-section__image {
    position: relative;

    width: 100%;

    min-height: 500px;

    border-radius: var(--theme-shape-radius);

    overflow: hidden;
  }

  /* SLIDES */

  .hero-slide {
    position: absolute;

    inset: 0;

    opacity: 0;

    transform: scale(1.02);

    transition:
      opacity 1s ease,
      transform 1.2s ease;

    pointer-events: none;
  }

  .hero-slide.is-active {
    opacity: 1;

    transform: scale(1);

    z-index: 1;
  }

  /* IMAGES */

  .hero-slide img {
    display: block;

    width: 100%;
    height: 100%;

    max-height: 80vh;

    object-fit: cover;

    border-radius: var(--theme-shape-radius);
  }

  /* MOBILE */

  @media (max-width: 768px) {

    .hero-section__section {
      grid-template-columns: 1fr;

      gap: 2rem;
    }

    .hero-section__text {
      max-width: 100%;
    }

    .hero-section__image {
      min-height: 320px;
    }

    .hero-slide img {
      max-height: 50vh;
    }

  }

</style>
