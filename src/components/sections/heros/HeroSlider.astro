---
import { Container, Button } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import settings from '../../../config/settings.js';
import { ThemeSwitcher } from '../../theme-switcher/theme-switcher';

interface HeroImage {
  src: string;
  alt?: string;
}

interface Props {
  images?: HeroImage[];
  interval?: number;
}

const {
  images = [
    {
      src: '/assets/images/home/classic-hero.jpg',
      alt: 'Astro Odyssey',
    },
  ],
  interval = 10000,
} = Astro.props;
---

<div
  class="hero-section__image"
  data-hero-slider
  data-interval={interval}
>
  {images.map((image, index) => (
    <picture class={`hero-slide ${index === 0 ? 'is-active' : ''}`}>
      <img
        src={image.src}
        alt={image.alt ?? 'Hero image'}
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    </picture>
  ))}
</div>

<script>
  const sliders = document.querySelectorAll('[data-hero-slider]');

  sliders.forEach((slider) => {
    const slides = slider.querySelectorAll('.hero-slide');

    if (slides.length <= 1) return;

    const interval =
      Number(slider.getAttribute('data-interval')) || 10000;

    let currentIndex = 0;

    setInterval(() => {
      slides[currentIndex].classList.remove('is-active');

      currentIndex = (currentIndex + 1) % slides.length;

      slides[currentIndex].classList.add('is-active');
    }, interval);
  });
</script>

<style>
  .hero-section__image {
    position: relative;
    width: 100%;
    /* Era 500px fissi: su una pagina con poco testo lasciava duecento pixel
       d'aria attorno alla colonna di fianco. Ora è fluido e più contenuto. */
    min-height: clamp(18rem, 44dvh, 28rem);
    border-radius: var(--radius-lg);
    /* Sfondo e ombra sul contenitore: se un file non carica la colonna resta
       una superficie, non un buco bianco. */
    background: var(--theme-surface-1);
    box-shadow: var(--theme-elevation-2);
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 1s ease,
      transform 1.2s ease;
    pointer-events: none;
  }

  .hero-slide.is-active {
    opacity: 1;
    transform: scale(1);
    z-index: 1;
  }

  /* Il raggio lo dà il contenitore, che ritaglia: qui raddoppierebbe. */
  .hero-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .hero-section__image {
      min-height: 14rem;
    }
  }
</style>
