---
import { Container } from '@components/odyssey-theme';

const { reversed } = Astro.props;
---

<Container>
	<section
		class={`text-and-image__section ${
			reversed && `text-and-image__section--reversed`
		}`}
	>
		<div class="text-and-image__text">
			<slot name="text-container" />
			<div class="text-and-image__btns">
				<slot name="btns-container" />
			</div>
		</div>
		<div class="text-and-image__image">
			<slot name="image-container" />
		</div>
	</section>
</Container>

<style>
	.text-and-image__section {
		/* Margine ottico: poco sopra (l'header gia' distanzia), molto sotto */
		margin: var(--space-md) auto var(--section-margin);
		min-height: clamp(28rem, 62dvh, calc(100dvh - var(--navbar-height)));
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
	}
	.text-and-image__section--reversed .text-and-image__text {
		order: 2;
	}
	.text-and-image__text {
		padding: 0;
		justify-self: start;
		max-width: 30rem;
	}
	.text-and-image__btns {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}
	.text-and-image__image :global(img) {
		width: 100%;
		height: 100%;
		max-height: 62dvh;
		object-fit: cover;
		/* Raggio piu' stretto dei contenitori: gerarchia di forme */
		border-radius: var(--radius-lg);
		box-shadow: var(--theme-elevation-2);
	}
	@media (max-width: 768px) {
		.text-and-image__section {
			margin: var(--space-sm) auto var(--space-xl);
			min-height: 0;
			grid-template-columns: 1fr;
		}
		.text-and-image__text {
			padding: var(--space-md) 0 0;
			max-width: none;
		}
	}
</style>
