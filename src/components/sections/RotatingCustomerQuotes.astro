---
import { CustomerQuoteSection } from '@components/odyssey-theme';

type Quote = {
  text: string;
  name?: string;
};

interface Props {
  quotes: Quote[];
  interval?: number; // in ms
}

const { quotes, interval = 4000 } = Astro.props as Props;

// prima citazione lato server
const first = quotes && quotes.length > 0 ? quotes[0] : null;
---

{first && (
  <div
    class="rotating-quotes"
    data-interval={interval}
    data-quotes={JSON.stringify(quotes)}
  >
    <CustomerQuoteSection
      quoteText={first.text}
      customerName={first.name}
    />
  </div>
)}

<style>
  .rotating-quotes {
    position: relative;
  }

  .rotating-quotes.fade-out {
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .rotating-quotes.fade-in {
    opacity: 1;
    transition: opacity 300ms ease-in;
  }
</style>

<script>
  const container = document.currentScript?.previousElementSibling?.previousElementSibling
    || document.querySelector('.rotating-quotes');

  if (container) {
    const quotes = JSON.parse(container.dataset.quotes || '[]');
    const interval = Number(container.dataset.interval || '4000');

    if (Array.isArray(quotes) && quotes.length > 1) {
      let index = 0;

      // Troviamo gli elementi di testo dentro CustomerQuoteSection
      const quoteEl = container.querySelector('[data-quote-text]') ||
        container.querySelector('.customer-quote__text') ||
        container.querySelector('blockquote, p');
      const nameEl = container.querySelector('[data-quote-name]') ||
        container.querySelector('.customer-quote__name');

      const show = (q) => {
        if (quoteEl) quoteEl.textContent = `“${q.text}”`;
        if (nameEl) nameEl.textContent = q.name ? `– ${q.name}` : '';
      };

      // inizializza classi
      container.classList.add('fade-in');

      setInterval(() => {
        // fade out
        container.classList.remove('fade-in');
        container.classList.add('fade-out');

        setTimeout(() => {
          // cambia citazione
          index = (index + 1) % quotes.length;
          show(quotes[index]);

          // fade in
          container.classList.remove('fade-out');
          container.classList.add('fade-in');
        }, 300); // durata del fade-out, deve matchare il CSS
      }, interval);
    }
  }
</script>
