---
import Container from '../core/Container.astro';
---

<Container>
	<section class="three-col-text__section">
		<div class="three-col-text__column">
			<div class="three-col-text__body">
				<slot name="column-1-body" />
			</div>
			<div class="three-col-text__cta"><slot name="column-1-cta" /></div>
		</div>
		<div class="three-col-text__column">
			<div class="three-col-text__body">
				<slot name="column-2-body" />
			</div>
			<div class="three-col-text__cta"><slot name="column-2-cta" /></div>
		</div>
		<div class="three-col-text__column">
			<div class="three-col-text__body">
				<slot name="column-3-body" />
			</div>
			<div class="three-col-text__cta"><slot name="column-3-cta" /></div>
		</div>
	</section>
</Container>

<style>
	/*
	  Prima: flex con justify-content: center su ogni colonna, quindi titoli e
	  pulsanti finivano ad altezze diverse a seconda della lunghezza del testo.
	  Ora e' una griglia: i titoli partono dalla stessa linea, i pulsanti sono
	  ancorati in fondo e formano una riga pulita.
	*/
	.three-col-text__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: stretch;
		text-align: left;
	}

	.three-col-text__column {
		display: grid;
		grid-template-rows: 1fr auto;
		gap: var(--space-md);
		padding-top: var(--space-md);
		/* Filetto in ottone: scandisce le colonne senza disegnare una card */
		border-top: 2px solid var(--theme-accent);
	}

	/* h2 o h3 a seconda della pagina: stessa resa, cosi' le colonne non divergono */
	.three-col-text__body :global(h2),
	.three-col-text__body :global(h3) {
		font-size: var(--font-size-lg);
		margin-bottom: var(--space-2xs);
	}

	.three-col-text__body :global(p) {
		color: var(--theme-muted);
		max-width: 34ch;
	}
	.three-col-text__body :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Ancorati in fondo: i pulsanti si allineano tra loro */
	.three-col-text__cta {
		align-self: end;
	}

	@media (max-width: 900px) {
		.three-col-text__section {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
		.three-col-text__column {
			grid-template-rows: auto auto;
		}
	}
</style>
