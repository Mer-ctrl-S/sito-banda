node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

icon.d.ts
*.cache

# Strumenti locali degli agenti IA (skill installate con `npx skills`,
